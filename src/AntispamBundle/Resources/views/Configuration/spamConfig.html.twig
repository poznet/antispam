{% extends '@Antispam/main.html.twig' %}
{% block title %}Ustawienia filtra{% endblock %}
{% block page_title %}Ustawienia filtra antyspamowego{% endblock %}

{% block body %}
    {# Connection tests and maintenance actions submit this form (buttons with
       form="spam-maintenance" + formaction): it cannot be nested in the main one. #}
    <form method="post" id="spam-maintenance">
        <input type="hidden" name="_token" value="{{ csrf_token('spam_maintenance') }}">
    </form>

    <form method="post">
    <input type="hidden" name="_token" value="{{ csrf_token('spam_config') }}">
    <div class="panel panel-default">
        <div class="panel-heading"><span class="glyphicon glyphicon-stats"></span> Ocena punktowa spamu</div>
        <div class="panel-body">
            <div class="checkbox"><label>
                <input type="checkbox" name="config[scoring_enabled]" {% if config.scoring_enabled %}checked{% endif %}>
                <strong>Włącz scoring pipeline</strong> — łącz sygnały z blacklist, nagłówków i DNSBL przed podjęciem decyzji.
            </label></div>
            <div class="checkbox"><label>
                <input type="checkbox" name="config[header_check_enabled]" {% if config.header_check_enabled %}checked{% endif %}>
                Analizuj nagłówki heurystycznie (SPF / DKIM / DMARC, podejrzany temat, brak Message-ID, ...)
            </label></div>
            <div class="checkbox"><label>
                <input type="checkbox" name="config[dnsbl_enabled]" {% if config.dnsbl_enabled %}checked{% endif %}>
                Sprawdzaj IP nadawcy u skonfigurowanych dostawców DNSBL
            </label></div>
            <div class="checkbox"><label>
                <input type="checkbox" name="config[clamav_enabled]" {% if config.clamav_enabled %}checked{% endif %}>
                Skanuj załączniki programem ClamAV (wykrycie wirusa oznacza wiadomość jako spam)
            </label></div>
            <div class="checkbox"><label>
                <input type="checkbox" name="config[log_enabled]" {% if config.log_enabled %}checked{% endif %}>
                Zapisuj dziennik ocen dla każdej wiadomości (zalecane)
            </label></div>

            <div class="row" style="margin-top:10px;">
                <div class="col-sm-6">
                    <label>Próg kwarantanny</label>
                    <input type="number" name="config[quarantine_threshold]" class="form-control" value="{{ config.quarantine_threshold }}" min="0" max="100">
                    <small class="text-muted">Wynik ≥ tej wartości → przeniesienie do folderu QUARANTINE.</small>
                </div>
                <div class="col-sm-6">
                    <label>Próg spamu</label>
                    <input type="number" name="config[spam_threshold]" class="form-control" value="{{ config.spam_threshold }}" min="1" max="200">
                    <small class="text-muted">Wynik ≥ tej wartości → traktuj jako spam.</small>
                </div>
            </div>
        </div>
    </div>

    <div class="panel panel-default">
        <div class="panel-heading"><span class="glyphicon glyphicon-paperclip"></span> Skanowanie załączników (ClamAV)</div>
        <div class="panel-body">
            <p class="text-muted">Wymaga działającego demona ClamAV (clamd) dostępnego z tej aplikacji. Włącz skanowanie w sekcji oceny punktowej powyżej.</p>
            <div class="row">
                <div class="col-sm-8">
                    <label>Adres clamd</label>
                    <input type="text" name="config[clamav_dsn]" class="form-control" value="{{ config.clamav_dsn }}" placeholder="tcp://127.0.0.1:3310">
                    <small class="text-muted">TCP (<code>tcp://host:port</code> lub <code>host:port</code>) albo gniazdo unix (<code>unix:///var/run/clamav/clamd.ctl</code>).</small>
                </div>
                <div class="col-sm-4">
                    <label>Punkty za wirusa</label>
                    <input type="number" name="config[clamav_score]" class="form-control" value="{{ config.clamav_score }}" min="1" max="200">
                    <small class="text-muted">Dodawane po wykryciu malware (wiadomość jest też oznaczana jako spam).</small>
                </div>
            </div>
            <div class="row" style="margin-top:10px;">
                <div class="col-sm-4">
                    <label>Maks. rozmiar załącznika (MiB)</label>
                    <input type="number" name="config[clamav_max_size_mib]" class="form-control" value="{{ config.clamav_max_size_mib }}" min="1" max="500">
                    <small class="text-muted">Większe załączniki są pomijane (musi być poniżej StreamMaxLength w clamd).</small>
                </div>
                <div class="col-sm-4">
                    <label>Timeout (sekundy)</label>
                    <input type="number" name="config[clamav_timeout]" class="form-control" value="{{ config.clamav_timeout }}" min="1" max="300">
                    <small class="text-muted">Limit czasu połączenia / odczytu na skan.</small>
                </div>
                <div class="col-sm-4">
                    <label>Łączność</label>
                    <div>
                        <button type="submit" form="spam-maintenance" formaction="{{ path('antispam_clamav_test') }}" class="btn btn-default">
                            <span class="glyphicon glyphicon-link"></span> Testuj połączenie
                        </button>
                    </div>
                    <small class="text-muted">Sprawdza clamd pod zapisanym adresem.</small>
                </div>
            </div>
        </div>
    </div>

    <div class="panel panel-default">
        <div class="panel-heading"><span class="glyphicon glyphicon-globe"></span> Reputacja załączników (VirusTotal)</div>
        <div class="panel-body">
            <p class="text-muted">Sprawdza hash SHA-256 każdego załącznika w VirusTotal. Wysyłany jest tylko hash — nigdy zawartość pliku. Wymaga klucza API VirusTotal (darmowy klucz ma limit ok. 4 zapytań/minutę).</p>
            <div class="checkbox"><label>
                <input type="checkbox" name="config[vt_enabled]" {% if config.vt_enabled %}checked{% endif %}>
                <strong>Włącz sprawdzanie załączników w VirusTotal</strong>
            </label></div>
            <div class="row" style="margin-top:10px;">
                <div class="col-sm-12">
                    <label>Klucz API</label>
                    {# Stored keys are never rendered back into the form. #}
                    <input type="password" name="config[vt_api_key]" class="form-control" value="" autocomplete="new-password"
                           placeholder="{{ config.vt_api_key.set ? '(ustawione' ~ (config.vt_api_key.hint ? ' ' ~ config.vt_api_key.hint) ~ ' - zostaw puste, aby nie zmieniać)' : 'Klucz API VirusTotal' }}">
                    {% if config.vt_api_key.set %}
                        <div class="checkbox"><label><input type="checkbox" name="config[vt_api_key_clear]" value="1"> Usuń zapisany klucz</label></div>
                    {% endif %}
                </div>
            </div>
            <div class="row" style="margin-top:10px;">
                <div class="col-sm-4">
                    <label>Próg wykryć</label>
                    <input type="number" name="config[vt_threshold]" class="form-control" value="{{ config.vt_threshold }}" min="1" max="90">
                    <small class="text-muted">Min. liczba silników uznających plik za złośliwy, zanim zostanie podjęta akcja.</small>
                </div>
                <div class="col-sm-4">
                    <label>Punkty za trafienie</label>
                    <input type="number" name="config[vt_score]" class="form-control" value="{{ config.vt_score }}" min="1" max="200">
                    <small class="text-muted">Dodawane przy trafieniu (wiadomość jest też oznaczana jako spam).</small>
                </div>
                <div class="col-sm-2">
                    <label>Timeout (s)</label>
                    <input type="number" name="config[vt_timeout]" class="form-control" value="{{ config.vt_timeout }}" min="1" max="120">
                </div>
                <div class="col-sm-2">
                    <label>Weryfikacja</label>
                    <div>
                        <button type="submit" form="spam-maintenance" formaction="{{ path('antispam_virustotal_test') }}" class="btn btn-default">
                            <span class="glyphicon glyphicon-link"></span> Testuj
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="panel panel-default">
        <div class="panel-heading"><span class="glyphicon glyphicon-user"></span> Ochrona przed podszywaniem się (BEC)</div>
        <div class="panel-body">
            <p class="text-muted">Wykrywa oszustwa „na prezesa” i domeny łudząco podobne: nazwisko chronionej osoby na obcym adresie, <code>firrna.pl</code> / <code>f1rma.pl</code> / <code>firma-pl.com</code> udające <code>firma.pl</code> oraz fałszowanie własnej domeny.</p>
            <div class="checkbox"><label>
                <input type="checkbox" name="config[impersonation_enabled]" {% if config.impersonation_enabled %}checked{% endif %}>
                <strong>Włącz ochronę przed podszywaniem się</strong>
            </label></div>
            <div class="checkbox"><label>
                <input type="checkbox" name="config[protect_own_domain]" {% if config.protect_own_domain %}checked{% endif %}>
                Automatycznie chroń własną domenę każdego konta (darmowe poczty jak gmail.com / wp.pl są pomijane)
            </label></div>
            <div class="row" style="margin-top:10px;">
                <div class="col-sm-6">
                    <label>Chronione domeny</label>
                    <textarea name="config[protected_domains]" class="form-control" rows="5" placeholder="firma.pl&#10;firma.com">{{ config.protected_domains }}</textarea>
                    <small class="text-muted">Jedna na linię. Poczta z domen łudząco do nich podobnych dostaje punkty.</small>
                </div>
                <div class="col-sm-6">
                    <label>Chronione osoby (VIP)</label>
                    <textarea name="config[vips]" class="form-control" rows="5" placeholder="Jan Kowalski &lt;jan.kowalski@firma.pl&gt;&#10;Anna Nowak">{{ config.vips }}</textarea>
                    <small class="text-muted">Jedna na linię: <code>Imię Nazwisko &lt;adres&gt;</code>. Bez adresu prawidłowy jest każdy adres w chronionej domenie. Wymagane pełne imię i nazwisko (min. dwa słowa).</small>
                </div>
            </div>
            <div class="row" style="margin-top:10px;">
                <div class="col-sm-3">
                    <label>Podszycie pod VIP</label>
                    <input type="number" name="config[impersonation_vip_score]" class="form-control" value="{{ config.impersonation_scores.vip }}" min="0" max="200">
                </div>
                <div class="col-sm-3">
                    <label>Podobna domena</label>
                    <input type="number" name="config[impersonation_lookalike_score]" class="form-control" value="{{ config.impersonation_scores.lookalike }}" min="0" max="200">
                </div>
                <div class="col-sm-3">
                    <label>Adres w nazwie nadawcy</label>
                    <input type="number" name="config[impersonation_embedded_score]" class="form-control" value="{{ config.impersonation_scores.embedded }}" min="0" max="200">
                </div>
                <div class="col-sm-3">
                    <label>Fałszywa własna domena</label>
                    <input type="number" name="config[impersonation_internal_score]" class="form-control" value="{{ config.impersonation_scores.internal }}" min="0" max="200">
                    <small class="text-muted">From = chroniona domena, ale SPF/DMARC nie przeszły.</small>
                </div>
            </div>
        </div>
    </div>

    <div class="panel panel-default">
        <div class="panel-heading"><span class="glyphicon glyphicon-link"></span> Ochrona przed złośliwymi linkami</div>
        <div class="panel-body">
            <p class="text-muted">Analizuje linki w treści. Każda reguła liczy się raz na wiadomość. Błędy DNS / API nigdy nie dodają punktów.</p>
            <div class="checkbox"><label>
                <input type="checkbox" name="config[url_enabled]" {% if config.url_enabled %}checked{% endif %}>
                <strong>Włącz analizę linków</strong>
            </label></div>
            <div class="row" style="margin-top:10px;">
                <div class="col-sm-3">
                    <label>Tekst ≠ cel linku</label>
                    <input type="number" name="config[url_mismatch_score]" class="form-control" value="{{ config.url.mismatch_score }}" min="0" max="200">
                    <small class="text-muted">Pokazuje <code>bank.pl</code>, prowadzi gdzie indziej.</small>
                </div>
                <div class="col-sm-3">
                    <label>Link do adresu IP</label>
                    <input type="number" name="config[url_ip_score]" class="form-control" value="{{ config.url.ip_score }}" min="0" max="200">
                </div>
                <div class="col-sm-3">
                    <label>Skracacz linków</label>
                    <input type="number" name="config[url_shortener_score]" class="form-control" value="{{ config.url.shortener_score }}" min="0" max="200">
                </div>
                <div class="col-sm-3">
                    <label>Domena IDN (punycode)</label>
                    <input type="number" name="config[url_punycode_score]" class="form-control" value="{{ config.url.punycode_score }}" min="0" max="200">
                </div>
            </div>
            <hr>
            <div class="checkbox"><label>
                <input type="checkbox" name="config[url_dbl_enabled]" {% if config.url.dbl_enabled %}checked{% endif %}>
                Sprawdzaj domeny z linków na listach URI (DBL)
            </label></div>
            <div class="row">
                <div class="col-sm-8">
                    <label>Strefy list URI</label>
                    <textarea name="config[url_dbl_zones]" class="form-control" rows="3" placeholder="dbl.spamhaus.org 6">{{ config.url_dbl_zones }}</textarea>
                    <small class="text-muted"><code>strefa punkty</code>, jedna na linię. Spamhaus i URIBL odrzucają zapytania z publicznych resolverów (8.8.8.8 itp.) — użyj lokalnego resolvera.</small>
                </div>
                <div class="col-sm-4">
                    <label>Maks. domen na wiadomość</label>
                    <input type="number" name="config[url_max_domains]" class="form-control" value="{{ config.url.max_domains }}" min="1" max="100">
                </div>
            </div>
            <hr>
            <div class="checkbox"><label>
                <input type="checkbox" name="config[url_gsb_enabled]" {% if config.url.gsb_enabled %}checked{% endif %}>
                Sprawdzaj linki w Google Safe Browsing (phishing / malware)
            </label></div>
            <div class="row">
                <div class="col-sm-8">
                    <label>Klucz API Safe Browsing</label>
                    <input type="password" name="config[url_gsb_api_key]" class="form-control" value="" autocomplete="new-password"
                           placeholder="{{ config.url.gsb_api_key.set ? '(ustawione' ~ (config.url.gsb_api_key.hint ? ' ' ~ config.url.gsb_api_key.hint) ~ ' - zostaw puste, aby nie zmieniać)' : 'Klucz Google Cloud z włączonym Safe Browsing API' }}">
                    <small class="text-muted">Pełne adresy URL są wysyłane do Google.</small>
                    {% if config.url.gsb_api_key.set %}
                        <div class="checkbox"><label><input type="checkbox" name="config[url_gsb_api_key_clear]" value="1"> Usuń zapisany klucz</label></div>
                    {% endif %}
                </div>
                <div class="col-sm-4">
                    <label>Punkty za trafienie</label>
                    <input type="number" name="config[url_gsb_score]" class="form-control" value="{{ config.url.gsb_score }}" min="0" max="200">
                </div>
            </div>
        </div>
    </div>

    <div class="panel panel-default">
        <div class="panel-heading"><span class="glyphicon glyphicon-ban-circle"></span> Polityka załączników</div>
        <div class="panel-body">
            <p class="text-muted">Reguły typów plików bez ClamAV ani klucza API — działają też na hostingu współdzielonym przez agenta Maildir.</p>
            <div class="checkbox"><label>
                <input type="checkbox" name="config[attachment_policy_enabled]" {% if config.attachment_policy_enabled %}checked{% endif %}>
                <strong>Włącz politykę załączników</strong>
            </label></div>
            <div class="row" style="margin-top:10px;">
                <div class="col-sm-12">
                    <label>Zablokowane rozszerzenia</label>
                    <textarea name="config[blocked_extensions]" class="form-control" rows="2">{{ config.blocked_extensions }}</textarea>
                    <small class="text-muted">Oddzielone przecinkami. Dotyczy też plików wewnątrz archiwów ZIP.</small>
                </div>
            </div>
            <div class="row" style="margin-top:10px;">
                <div class="col-sm-4">
                    <label>Zablokowany typ</label>
                    <input type="number" name="config[attachment_blocked_score]" class="form-control" value="{{ config.attachment.blocked_score }}" min="0" max="200">
                </div>
                <div class="col-sm-4">
                    <label>Podwójne rozszerzenie / ukryte znaki</label>
                    <input type="number" name="config[attachment_double_ext_score]" class="form-control" value="{{ config.attachment.double_ext_score }}" min="0" max="200">
                    <small class="text-muted"><code>faktura.pdf.exe</code></small>
                </div>
                <div class="col-sm-4">
                    <label>Program udający dokument</label>
                    <input type="number" name="config[attachment_mismatch_score]" class="form-control" value="{{ config.attachment.mismatch_score }}" min="0" max="200">
                    <small class="text-muted">Plik wykonywalny pod nazwą dokumentu.</small>
                </div>
            </div>
            <div class="row" style="margin-top:10px;">
                <div class="col-sm-4">
                    <label>Makra / aktywny PDF</label>
                    <input type="number" name="config[attachment_macro_score]" class="form-control" value="{{ config.attachment.macro_score }}" min="0" max="200">
                </div>
                <div class="col-sm-4">
                    <label>Plik chroniony hasłem</label>
                    <input type="number" name="config[attachment_encrypted_score]" class="form-control" value="{{ config.attachment.encrypted_score }}" min="0" max="200">
                    <small class="text-muted">Zaszyfrowany ZIP lub dokument Office — nieczytelny dla skanerów.</small>
                </div>
            </div>
        </div>
    </div>

    {% if bayes %}
    <div class="panel panel-default" id="bayes">
        <div class="panel-heading"><span class="glyphicon glyphicon-education"></span> Klasyfikator uczący się (Bayes)</div>
        <div class="panel-body">
            <p class="text-muted">Lokalny filtr bayesowski uczy się na decyzjach użytkowników (zgłoszenia z wtyczki „spam / nie spam”, zgłoszenia phishingu, przywrócenie z kwarantanny lub folderu SPAM) i wyłapuje spam z czystymi nagłówkami, którego nie ma na żadnej liście. Dane zostają na tym serwerze; zapisywane są tylko skróty (hash) słów, nie ich treść. Zobacz <code>docs/bayes.md</code>.</p>
            <div class="checkbox"><label>
                <input type="checkbox" name="config[bayes_enabled]" {% if bayes.enabled %}checked{% endif %}>
                <strong>Włącz klasyfikator Bayesa</strong> (nauka i ocena; punkty dopiero po zebraniu minimalnej liczby przykładów)
            </label></div>
            <div class="checkbox"><label>
                <input type="checkbox" name="config[bayes_per_mailbox]" {% if bayes.per_mailbox %}checked{% endif %}>
                Ucz się także osobno dla każdej skrzynki (skrzynka z wystarczającą liczbą przykładów jest oceniana własną bazą, pozostałe wspólną)
            </label></div>
            <div class="row" style="margin-top:10px;">
                <div class="col-sm-3">
                    <label>Min. wiadomości spam</label>
                    <input type="number" name="config[bayes_min_spam]" class="form-control" value="{{ bayes.min_spam }}" min="1" max="100000">
                </div>
                <div class="col-sm-3">
                    <label>Min. wiadomości nie-spam</label>
                    <input type="number" name="config[bayes_min_ham]" class="form-control" value="{{ bayes.min_ham }}" min="1" max="100000">
                </div>
                <div class="col-sm-6">
                    <label>Maks. tokenów wysyłanych do agentów SSH</label>
                    <input type="number" name="config[bayes_agent_max_tokens]" class="form-control" value="{{ bayes.agent_max_tokens }}" min="0" max="50000">
                    <small class="text-muted">0 = agenci nie oceniają Bayesem.</small>
                </div>
            </div>
            <div class="row" style="margin-top:10px;">
                <div class="col-sm-4">
                    <label>Punkty: prawdopodobieństwo ≥ 0,99</label>
                    <input type="number" name="config[bayes_spam_score]" class="form-control" value="{{ bayes.spam_score }}" min="0" max="200">
                </div>
                <div class="col-sm-4">
                    <label>Punkty: prawdopodobieństwo ≥ 0,90</label>
                    <input type="number" name="config[bayes_likely_score]" class="form-control" value="{{ bayes.likely_score }}" min="0" max="200">
                </div>
                <div class="col-sm-4">
                    <label>Odejmij: prawdopodobieństwo ≤ 0,01</label>
                    <input type="number" name="config[bayes_ham_score]" class="form-control" value="{{ bayes.ham_score }}" min="0" max="200">
                    <small class="text-muted">Nigdy dla nadawcy z blacklisty.</small>
                </div>
            </div>
            {% if bayes.stats %}
                <p style="margin-top:12px;">
                    Nauczone wiadomości (baza wspólna): <strong>{{ bayes.stats.spam }}</strong> spam, <strong>{{ bayes.stats.ham }}</strong> nie-spam;
                    tokenów: <strong>{{ bayes.stats.tokens }}</strong>{% if bayes.stats.scopes %} (wszystkie skrzynki: {{ bayes.stats.tokens_all }}, skrzynek z własną bazą: {{ bayes.stats.scopes }}){% endif %}.
                    {% if bayes.stats.ready %}
                        <span class="label label-success">ocenia</span>
                    {% else %}
                        <span class="label label-default">za mało przykładów (min. {{ bayes.stats.min_spam }} / {{ bayes.stats.min_ham }})</span>
                    {% endif %}
                </p>
            {% else %}
                <p class="text-warning" style="margin-top:12px;">Tabele klasyfikatora nie istnieją jeszcze - uruchom <code>php bin/console antispam:db:upgrade</code>.</p>
            {% endif %}
            <small class="text-muted">Wstępna nauka z folderów IMAP: <code>php bin/console antispam:bayes:train --account=adres@skrzynki --folder=SPAM --ham-folder=INBOX --limit=500</code></small>
        </div>
    </div>
    {% endif %}

    <div class="panel panel-default">
        <div class="panel-heading"><span class="glyphicon glyphicon-cog"></span> Postępowanie ze spamem</div>
        <div class="panel-body">
            <div class="row" style="padding: 15px 0;">
                <div class="col-xs-9">
                    <strong>Usuwaj spam na stałe</strong>
                    <p class="text-muted" style="margin:0;">Gdy wyłączone, spam jest przenoszony do folderu SPAM zamiast usuwania</p>
                </div>
                <div class="col-xs-3 text-right">
                    <input type="checkbox" name="config[delete]" {% if config.delete==true %}checked{% endif %}>
                </div>
            </div>
        </div>
    </div>

    <button type="submit" class="btn btn-primary"><span class="glyphicon glyphicon-floppy-disk"></span> Zapisz</button>
    </form>

    <div class="panel panel-default" style="margin-top:20px;">
        <div class="panel-heading"><span class="glyphicon glyphicon-wrench"></span> Konserwacja</div>
        <div class="panel-body">
            <button type="submit" form="spam-maintenance" formaction="{{ path('antispam_spam_unchekall') }}" class="btn btn-warning"
                    data-confirm="Zresetować wszystkie flagi sprawdzenia? Wszystkie wiadomości zostaną ponownie przetworzone przy następnym skanie.">
                <span class="glyphicon glyphicon-refresh"></span> Resetuj flagi sprawdzenia
            </button>
            <button type="submit" form="spam-maintenance" formaction="{{ path('antispam_spam_resetcounters') }}" class="btn btn-warning"
                    data-confirm="Wyzerować liczniki wszystkich reguł?">
                <span class="glyphicon glyphicon-stats"></span> Zeruj liczniki
            </button>
            {% if bayes %}
            <button type="submit" form="spam-maintenance" formaction="{{ path('antispam_bayes_reset') }}" class="btn btn-danger"
                    data-confirm="Wyczyścić bazę klasyfikatora Bayesa? Wszystkie nauczone wiadomości i tokeny (wszystkich skrzynek) zostaną usunięte.">
                <span class="glyphicon glyphicon-trash"></span> Wyczyść bazę Bayesa
            </button>
            {% endif %}
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('bundles/antispam/js/data-confirm.js') }}"></script>
{% endblock %}
