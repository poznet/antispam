# Copy to .env (or paste into Coolify's Environment Variables UI) and adjust.
# The container refuses to start while APP_SECRET, ADMIN_PASSWORD or
# DATABASE_PASSWORD is empty or a default value. Generate secrets with:
#   php -r "echo bin2hex(random_bytes(32));"

# Symfony
APP_SECRET=

# Application login - required to access the web UI
ADMIN_USER=admin
ADMIN_PASSWORD=

# Database (used by both the app and the db service)
DATABASE_NAME=antispam
DATABASE_USER=antispam
DATABASE_PASSWORD=
DATABASE_ROOT_PASSWORD=

# Mailer (optional - leave empty to disable outbound mail), Symfony Mailer DSN:
# smtp://user:pass@smtp.example.com:587
MAILER_DSN=

# Database schema upgrade at boot: antispam:db:upgrade (Doctrine Migrations,
# docs/migrations.md). "false" = run it yourself after each deploy.
RUN_MIGRATIONS=true
# "true" = the container exits when the upgrade fails (default: log loudly, start anyway).
RUN_MIGRATIONS_STRICT=false

# Scheduler service (docker-compose.prod.yml)
SCAN_INTERVAL=5
FEED_SYNC_INTERVAL=15
# Hour in UTC; "off" disables the daily quarantine digest
DIGEST_HOUR=7

# Directory with the SSH private keys of SSH+Maildir accounts
# (empty = var/data/ssh-keys, on the app-data volume)
SSH_KEYS_DIR=

# Local testing only: start even with default/empty secrets. Never in production.
ALLOW_INSECURE_DEFAULTS=0
