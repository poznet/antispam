{% extends '@Antispam/main.html.twig' %}
{% block title %}Blacklista e-mail{% endblock %}
{% block page_title %}Blacklista adresów e-mail{% endblock %}

{% block body %}
    <div class="add-form">
        <form method="post" action="{{ path('antispam_emailblacklist_add') }}" class="form-inline">
            <input type="text" class="form-control" name="email" placeholder="spammer@example.com, *@*.ru lub regex" required style="min-width:280px;">
            <select name="pattern_type" class="form-control">
                <option value="exact">Dokładny</option>
                <option value="wildcard">Wildcard</option>
                <option value="regex">Regex</option>
            </select>
            <input type="number" class="form-control" name="score" value="10" min="1" max="50" title="Punkty spamu dodawane przy trafieniu" style="width:90px;">
            <button type="submit" class="btn btn-danger"><span class="glyphicon glyphicon-plus"></span> Dodaj</button>
        </form>
    </div>

    {% if list|length > 0 %}
    <ul class="list-group">
        {% for l in list %}
        <li class="list-group-item">
            <a href="{{ path('antispam_emailblacklist_del',{'id':l.id}) }}" class="btn btn-danger btn-xs list-actions" onclick="return confirm('Usunąć ten adres z blacklisty?')">
                <span class="glyphicon glyphicon-remove"></span> Usuń
            </a>
            <span class="badge badge-counter">{{ l.counter }} trafień</span>
            <span class="label label-default">{{ l.patternType }}</span>
            <span class="label label-warning">punkty {{ l.score }}</span>
            <span class="glyphicon glyphicon-envelope"></span> {{ l.blacklistemail }}
        </li>
        {% endfor %}
    </ul>
    {% else %}
    <div class="empty-state">
        <span class="glyphicon glyphicon-ban-circle"></span>
        <p>Blacklista adresów e-mail jest pusta</p>
        <p class="text-muted">Obsługuje wzorce dokładne, wildcard i regex</p>
    </div>
    {% endif %}
{% endblock %}
