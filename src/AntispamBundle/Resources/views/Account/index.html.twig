{% extends '@Antispam/main.html.twig' %}

{% block title %}Konta{% endblock %}
{% block page_title %}Konta pocztowe{% endblock %}

{% block body %}
    <div class="pp-toolbar">
        <a href="{{ path('antispam_account_add') }}" class="btn btn-primary"><span class="glyphicon glyphicon-plus"></span> Dodaj konto</a>
        <span class="pp-spacer"></span>
        <a href="{{ path('antispam_account_download_agent') }}" class="btn btn-default"><span class="glyphicon glyphicon-download-alt"></span> Pobierz agenta</a>
    </div>

    <div class="table-responsive">
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Nazwa</th>
                <th>E-mail</th>
                <th>Typ</th>
                <th>Host</th>
                <th>Agent</th>
                <th>Ostatni skan</th>
                <th>Akcje</th>
            </tr>
        </thead>
        <tbody>
        {% for account in accounts %}
            <tr>
                <td><div class="pp-acct"><span class="pp-acct-ic">{{ account.name|first }}</span><b>{{ account.name }}</b></div></td>
                <td>{{ account.email }}</td>
                <td>
                    {% if account.connectionType == 'ssh' %}
                        <span class="label label-info">SSH+Maildir</span>
                    {% else %}
                        <span class="label label-default">IMAP</span>
                    {% endif %}
                </td>
                <td class="pp-mono">
                    {% if account.connectionType == 'ssh' %}
                        {{ account.sshHost }}
                    {% else %}
                        {{ account.imapHost }}
                    {% endif %}
                </td>
                <td>
                    {% if account.connectionType == 'ssh' %}
                        {% if account.agentDeployed %}
                            <span class="label label-success">Wdrożony</span>
                        {% else %}
                            <span class="label label-warning">Niewdrożony</span>
                        {% endif %}
                    {% else %}
                        <span class="label label-default">n/d</span>
                    {% endif %}
                </td>
                <td class="pp-mono">
                    {% if account.lastScanAt %}
                        {{ account.lastScanAt|date('Y-m-d H:i') }}
                    {% else %}
                        <span class="text-muted">Nigdy</span>
                    {% endif %}
                </td>
                <td>
                    {# Actions are POST + CSRF token; the buttons share one form. #}
                    <form method="post" style="margin:0">
                    <input type="hidden" name="_token" value="{{ csrf_token('account_action_' ~ account.id) }}">
                    <div class="btn-group btn-group-xs">
                        <a href="{{ path('antispam_account_edit', {id: account.id}) }}" class="btn btn-default" title="Edytuj"><span class="glyphicon glyphicon-pencil"></span> Edytuj</a>
                        <button type="submit" formaction="{{ path('antispam_account_test', {id: account.id}) }}" class="btn btn-info" title="Test połączenia"><span class="glyphicon glyphicon-link"></span> Test</button>
                        <button type="submit" formaction="{{ path('antispam_account_scan', {id: account.id}) }}" class="btn btn-primary" title="Uruchom skan"><span class="glyphicon glyphicon-play"></span> Skanuj</button>
                        {% if account.connectionType == 'ssh' %}
                            <button type="submit" formaction="{{ path('antispam_account_deploy', {id: account.id}) }}" class="btn btn-warning" title="Wdróż agenta"><span class="glyphicon glyphicon-cloud-upload"></span> Wdróż</button>
                            <button type="submit" formaction="{{ path('antispam_account_sync', {id: account.id}) }}" class="btn btn-success" title="Synchronizuj reguły"><span class="glyphicon glyphicon-refresh"></span> Synchronizuj</button>
                            <button type="submit" formaction="{{ path('antispam_account_health', {id: account.id}) }}" class="btn btn-info" title="Sprawdź stan agenta"><span class="glyphicon glyphicon-heart"></span> Stan</button>
                        {% endif %}
                        <button type="submit" formaction="{{ path('antispam_account_del', {id: account.id}) }}" class="btn btn-danger" title="Usuń" onclick="return confirm('Usunąć to konto?')"><span class="glyphicon glyphicon-trash"></span></button>
                    </div>
                    </form>
                </td>
            </tr>
            {% if account.lastScanResult %}
            <tr>
                <td colspan="7" class="pp-subrow">
                    {% set scanData = account.lastScanResultDecoded %}
                    {% if scanData %}
                        <div class="pp-scan-stats">
                            <span>Wszystkie <b>{{ scanData.total|default(0) }}</b></span>
                            <span>Sprawdzone <b>{{ scanData.checked|default(0) }}</b></span>
                            <span>Pominięte <b>{{ scanData.skipped|default(0) }}</b></span>
                            <span>Whitelista <b>{{ scanData.whitelisted|default(0) }}</b></span>
                            <span>Blacklista <b>{{ scanData.blacklisted|default(0) }}</b></span>
                            <span>Do spamu <b>{{ scanData.moved_to_spam|default(0) }}</b></span>
                        </div>
                    {% endif %}
                </td>
            </tr>
            {% endif %}
        {% else %}
            <tr><td colspan="7" class="text-center text-muted" style="padding:40px;">Brak skonfigurowanych kont &mdash; <a href="{{ path('antispam_account_add') }}">dodaj pierwsze konto</a></td></tr>
        {% endfor %}
        </tbody>
    </table>
    </div>
{% endblock %}
