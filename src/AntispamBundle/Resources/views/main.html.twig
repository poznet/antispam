<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <title>{% block title %}Antispam{% endblock %} &middot; Pancernapanda antispam</title>
    <link rel="icon" type="image/x-icon" href="{{ asset('favicon.ico') }}">

    <script>
        (function () {
            var t = null;
            try { t = localStorage.getItem('pp-theme'); } catch (e) {}
            if (!t) { t = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'; }
            document.documentElement.setAttribute('data-theme', t);
        })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap">
    <link rel="stylesheet" href="{{ asset('bundles/antispam/vendor/bootstrap/css/bootstrap.min.css') }}">
    <link rel="stylesheet" href="{{ asset('bundles/antispam/css/panel.css') }}">
    {% block stylesheets %}{% endblock %}
</head>
{% set route = app.request.attributes.get('_route') %}
{% set nav = [
    {section: 'Przegląd'},
    {label: 'Pulpit',               icon: 'dashboard',    path: 'antispam_index',                match: ['antispam_index']},
    {label: 'Konta',                icon: 'cloud',        path: 'antispam_account_index',        match: ['antispam_account_index', 'antispam_account_add', 'antispam_account_edit', 'antispam_account_test', 'antispam_account_scan', 'antispam_account_deploy', 'antispam_account_sync', 'antispam_account_health']},
    {section: 'Skrzynki'},
    {label: 'Folder spamu',         icon: 'inbox',        path: 'antispam_spambox_index',        match: ['antispam_spambox_index']},
    {label: 'Kwarantanna',          icon: 'warning-sign', path: 'antispam_spambox_quarantine',   match: ['antispam_spambox_quarantine']},
    {label: 'Dziennik ocen',        icon: 'list-alt',     path: 'antispam_spambox_scorelog',     match: ['antispam_spambox_scorelog']},
    {section: 'Whitelisty'},
    {label: 'Whitelista domen',     icon: 'ok-circle',    path: 'antispam_whitelist_index',      match: ['antispam_whitelist_index']},
    {label: 'Whitelista e-mail',    icon: 'check',        path: 'antispam_emailwhitelist_index', match: ['antispam_emailwhitelist_index']},
    {section: 'Blacklisty'},
    {label: 'Blacklista domen',     icon: 'ban-circle',   path: 'antispam_blacklist_index',      match: ['antispam_blacklist_index']},
    {label: 'Blacklista e-mail',    icon: 'envelope',     path: 'antispam_emailblacklist_index', match: ['antispam_emailblacklist_index']},
    {label: 'Dostawcy DNSBL',       icon: 'globe',        path: 'antispam_dnsbl_index',          match: ['antispam_dnsbl_index', 'antispam_dnsbl_test']},
    {label: 'Import / eksport',     icon: 'transfer',     path: 'antispam_bulk_index',           match: ['antispam_bulk_index']},
    {section: 'Ustawienia'},
    {label: 'Filtr spamu',          icon: 'tasks',        path: 'antispam_spam_config',          match: ['antispam_spam_config']},
    {label: 'Wspólna baza spamu',   icon: 'signal',       path: 'antispam_feed_config',          match: ['antispam_feed_config']},
    {label: 'Konfiguracja (stara)', icon: 'cog',          path: 'antispam_account_config',       match: ['antispam_account_config']}
] %}
{% set crumb = 'Przegląd' %}
{% for item in nav %}
    {% if item.section is defined %}{% set section = item.section %}{% elseif route in item.match %}{% set crumb = section %}{% endif %}
{% endfor %}
<body class="pp-app">

<aside class="pp-sidebar" id="pp-sidebar">
    <a class="pp-brand" href="{{ path('antispam_index') }}">
        <span class="pp-brand-logo" aria-hidden="true">
            <svg viewBox="0 0 40 40" xmlns="http://www.w3.org/2000/svg">
                <circle cx="20" cy="21" r="14" fill="#ffffff"/>
                <ellipse cx="10" cy="11" rx="5" ry="6" fill="#1e1b4b"/>
                <ellipse cx="30" cy="11" rx="5" ry="6" fill="#1e1b4b"/>
                <ellipse cx="13" cy="22" rx="4" ry="5" fill="#1e1b4b"/>
                <ellipse cx="27" cy="22" rx="4" ry="5" fill="#1e1b4b"/>
                <circle cx="13" cy="22" r="1.6" fill="#ffffff"/>
                <circle cx="27" cy="22" r="1.6" fill="#ffffff"/>
                <ellipse cx="20" cy="27" rx="2.2" ry="1.6" fill="#1e1b4b"/>
                <path d="M16.5 30 Q20 33 23.5 30" stroke="#1e1b4b" stroke-width="1.4" fill="none" stroke-linecap="round"/>
            </svg>
        </span>
        <span class="pp-brand-name">
            <strong>Pancernapanda</strong>
            <span>antispam</span>
        </span>
    </a>

    <nav class="pp-nav" aria-label="Menu główne">
        {% for item in nav %}
            {% if item.section is defined %}
                <div class="pp-nav-section">{{ item.section }}</div>
            {% else %}
                <a href="{{ path(item.path) }}" class="{{ route in item.match ? 'active' }}"{% if route in item.match %} aria-current="page"{% endif %}>
                    <span class="glyphicon glyphicon-{{ item.icon }}" aria-hidden="true"></span> {{ item.label }}
                </a>
            {% endif %}
        {% endfor %}
    </nav>

    <div class="pp-sidebar-foot">
        <strong><span class="pp-status-dot"></span>Ochrona aktywna</strong>
        Pancerna ochrona Twojej skrzynki przed spamem
    </div>
</aside>
<div class="pp-backdrop" data-pp-toggle-nav></div>

<div class="pp-main">
    <header class="pp-topbar">
        <button type="button" class="pp-icon-btn pp-menu-btn" data-pp-toggle-nav aria-label="Pokaż/ukryj menu" aria-controls="pp-sidebar">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
        <div class="pp-topbar-title">
            <div class="pp-crumb">Antyspam<span class="glyphicon glyphicon-menu-right"></span>{{ crumb }}</div>
            <h1>{% block page_title %}{% endblock %}</h1>
        </div>
        <button type="button" class="pp-icon-btn" id="pp-theme-toggle" aria-label="Przełącz tryb ciemny" title="Tryb jasny / ciemny">
            <svg class="pp-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
            <svg class="pp-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        </button>
        {% if app.user %}
            <div class="pp-user dropdown">
                <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-haspopup="true" aria-expanded="false">
                    <span class="pp-avatar">{{ app.user.username|first }}</span>
                    <span class="pp-user-name">{{ app.user.username }}</span>
                </a>
                <ul class="dropdown-menu dropdown-menu-right">
                    <li class="dropdown-header">Zalogowano jako {{ app.user.username }}</li>
                    <li><a href="{{ path('antispam_spam_config') }}"><span class="glyphicon glyphicon-cog"></span> Ustawienia</a></li>
                    <li role="separator" class="divider"></li>
                    <li><a href="{{ path('logout') }}"><span class="glyphicon glyphicon-log-out"></span> Wyloguj</a></li>
                </ul>
            </div>
        {% endif %}
    </header>

    <main class="pp-content">
        {% for type, messages in app.session.flashbag.all() %}
            {% for message in messages %}
                <div class="alert alert-{{ type }} alert-dismissible" role="alert">
                    <button type="button" class="close" data-dismiss="alert" aria-label="Zamknij"><span aria-hidden="true">&times;</span></button>
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        {% block body %}{% endblock %}
    </main>

    <footer class="pp-footer">
        <span><strong>Pancernapanda antispam</strong> &mdash; pancerna ochrona Twojej skrzynki przed spamem</span>
        <span>&copy; {{ 'now'|date('Y') }} Pancernapanda</span>
    </footer>
</div>

<script src="{{ asset('bundles/antispam/vendor/jquery/jquery.min.js') }}"></script>
<script src="{{ asset('bundles/antispam/vendor/bootstrap/js/bootstrap.min.js') }}"></script>
<script>
    (function () {
        var root = document.documentElement;
        document.getElementById('pp-theme-toggle').addEventListener('click', function () {
            var next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
            root.setAttribute('data-theme', next);
            try { localStorage.setItem('pp-theme', next); } catch (e) {}
        });
        Array.prototype.forEach.call(document.querySelectorAll('[data-pp-toggle-nav]'), function (el) {
            el.addEventListener('click', function () { document.body.classList.toggle('pp-nav-open'); });
        });
    })();
</script>
{% block javascripts %}{% endblock %}
</body>
</html>
