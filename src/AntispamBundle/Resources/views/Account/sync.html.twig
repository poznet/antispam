{% extends 'AntispamBundle::main.html.twig' %}

{% block title %}Synchronizacja reguł{% if account %}: {{ account.name }}{% endif %}{% endblock %}
{% block page_title %}Synchronizacja reguł{% if account %}: {{ account.name }}{% endif %}{% endblock %}

{% block body %}
    {% if result.success %}
        <div class="alert alert-success"><strong>Reguły zostały zsynchronizowane!</strong></div>
    {% else %}
        <div class="alert alert-danger"><strong>Synchronizacja nie powiodła się</strong></div>
    {% endif %}

    <ul class="list-group">
    {% for message in result.messages %}
        <li class="list-group-item">{{ message }}</li>
    {% endfor %}
    </ul>

    {% if result.sync_result is defined %}
        <h4>Wynik synchronizacji:</h4>
        <pre>{{ result.sync_result|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
    {% endif %}

    <a href="{{ path('antispam_account_index') }}" class="btn btn-default"><span class="glyphicon glyphicon-arrow-left"></span> Powrót do kont</a>
{% endblock %}
