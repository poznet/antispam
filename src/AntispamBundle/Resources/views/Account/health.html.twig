{% extends '@Antispam/main.html.twig' %}
{% block title %}Stan agenta{% endblock %}
{% block page_title %}Stan agenta — {{ account.name|default('?') }}{% endblock %}

{% block body %}
    {% if result.success %}
        <div class="alert alert-success">Agent odpowiada</div>
        <table class="table table-bordered">
        {% for k, v in result.health %}
            <tr><th style="width:30%;">{{ k }}</th><td><pre style="margin:0;">{{ v is iterable ? v|json_encode : v }}</pre></td></tr>
        {% endfor %}
        </table>
    {% else %}
        <div class="alert alert-danger">
            {% for m in result.messages %}{{ m }}<br>{% endfor %}
        </div>
    {% endif %}
    <a href="{{ path('antispam_account_index') }}" class="btn btn-default"><span class="glyphicon glyphicon-arrow-left"></span> Powrót do kont</a>
{% endblock %}
