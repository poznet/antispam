{% extends '@Antispam/main.html.twig' %}
{% block title %}Raport kwarantanny{% endblock %}
{% block page_title %}Raport kwarantanny{% endblock %}

{% block body %}
    <p class="text-muted">
        Wysyła właścicielowi każdej skrzynki e-mail z nowymi wiadomościami w kwarantannie i przyciskami
        <strong>Przywróć</strong>, <strong>Zawsze akceptuj</strong> i <strong>Usuń</strong>.
        Linki są podpisane i wygasają; otwarcie linku pokazuje tylko stronę potwierdzenia, więc skanery poczty, które otwierają linki, niczego nie wypuszczą.
    </p>

    {% if errors %}
    <div class="alert alert-warning">
        {% for e in errors %}<div>{{ e }}</div>{% endfor %}
    </div>
    {% endif %}

    <form method="post">
    <input type="hidden" name="_token" value="{{ csrf_token('digest_config') }}">
    <div class="panel panel-default">
        <div class="panel-heading"><span class="glyphicon glyphicon-envelope"></span> Ustawienia</div>
        <div class="panel-body">
            <div class="checkbox"><label>
                <input type="checkbox" name="config[enabled]" {% if config.enabled %}checked{% endif %}>
                <strong>Włącz raport kwarantanny</strong>
            </label></div>
            <div class="row" style="margin-top:10px;">
                <div class="col-sm-6">
                    <label>Publiczny adres aplikacji</label>
                    <input type="url" name="config[base_url]" class="form-control" value="{{ config.base_url }}" placeholder="https://antispam.example.com">
                    <small class="text-muted">Adres, pod którym odbiorcy otworzą aplikację. Linki prowadzą do <code>&lt;adres&gt;/q/…</code>.</small>
                </div>
                <div class="col-sm-3">
                    <label>Adres nadawcy</label>
                    <input type="email" name="config[from_email]" class="form-control" value="{{ config.from_email }}" placeholder="antispam@example.com">
                </div>
                <div class="col-sm-3">
                    <label>Nazwa nadawcy</label>
                    <input type="text" name="config[from_name]" class="form-control" value="{{ config.from_name }}" placeholder="Pancernapanda antispam">
                </div>
            </div>
            <div class="row" style="margin-top:10px;">
                <div class="col-sm-6">
                    <label>Odbiorca dla starej skrzynki IMAP</label>
                    <input type="email" name="config[imap_recipient]" class="form-control" value="{{ config.imap_recipient }}" placeholder="domyślnie skonfigurowany e-mail IMAP">
                    <small class="text-muted">Konta SSH zawsze dostają raport na adres konta.</small>
                </div>
                <div class="col-sm-3">
                    <label>Ważność linków (dni)</label>
                    <input type="number" name="config[token_ttl_days]" class="form-control" value="{{ config.token_ttl_days }}" min="1" max="30">
                </div>
                <div class="col-sm-3">
                    <label>Maks. wiadomości w raporcie</label>
                    <input type="number" name="config[max_items]" class="form-control" value="{{ config.max_items }}" min="1" max="500">
                </div>
            </div>
            <p class="text-muted" style="margin-top:15px;">
                Poczta wychodzi przez mailer aplikacji (ustawienia <code>MAILER_*</code>). Zaplanuj wysyłkę w cronie, np. codziennie o 7:00:<br>
                <code>0 7 * * * php bin/console antispam:digest:send</code>
            </p>
        </div>
    </div>

    <button type="submit" class="btn btn-primary"><span class="glyphicon glyphicon-floppy-disk"></span> Zapisz</button>
    <button type="submit" name="send_now" value="1" class="btn btn-default" data-confirm="Zapisać ustawienia i wysłać teraz raporty do wszystkich skrzynek z nowymi wiadomościami w kwarantannie?">
        <span class="glyphicon glyphicon-send"></span> Zapisz i wyślij teraz
    </button>
    </form>

    <div class="panel panel-default" style="margin-top:20px;">
        <div class="panel-heading"><span class="glyphicon glyphicon-inbox"></span> Skrzynki</div>
        <div class="panel-body">
        {% if mailboxes %}
            <div class="table-responsive">
            <table class="table table-striped">
                <thead><tr><th>Skrzynka</th><th>Odbiorca raportu</th><th>Raport</th><th>Ostatni raport</th><th></th></tr></thead>
                <tbody>
                {% for m in mailboxes %}
                    <tr>
                        <td>{{ m.label }} <small class="text-muted">({{ m.key }})</small></td>
                        <td>{{ m.recipient ?: '—' }}</td>
                        <td>
                            {% if m.digest_enabled is same as(false) %}<span class="label label-default">wyłączony dla skrzynki</span>
                            {% elseif m.digest_enabled is same as(true) %}<span class="label label-info">włączony dla skrzynki</span>
                            {% else %}<span class="text-muted">globalnie</span>{% endif %}
                            {% if m.digest_hour is not null %}<span class="label label-info">o {{ m.digest_hour }}:00</span>{% endif %}
                        </td>
                        <td>{{ m.last_sent ? m.last_sent|date('Y-m-d H:i') : 'nigdy' }}</td>
                        <td class="text-right">
                            <a href="{{ path('antispam_digest_preview', {key: m.key}) }}" class="btn btn-xs btn-default" target="_blank">
                                <span class="glyphicon glyphicon-eye-open"></span> Podgląd (7 dni)
                            </a>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
            </div>
            <p class="help-block">Włączenie, odbiorcę i godzinę raportu pojedynczej skrzynki ustawisz w <a href="{{ path('antispam_account_index') }}">Konta</a> → Edytuj → Ustawienia skrzynki. Skrzynka z własną godziną dostaje raport przy pierwszym uruchomieniu <code>antispam:digest:send</code> od tej godziny (scheduler w Dockerze uruchamia go co godzinę z <code>--scheduled-only</code>).</p>
        {% else %}
            <p class="text-muted">Żadna skrzynka nie ma jeszcze kwarantanny: skonfiguruj starą skrzynkę IMAP albo wdróż agenta na konto SSH.</p>
        {% endif %}
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('bundles/antispam/js/data-confirm.js') }}"></script>
{% endblock %}
