{% extends '@Antispam/main.html.twig' %}

{% block title %}Dodaj konto{% endblock %}
{% block page_title %}Dodaj konto{% endblock %}

{% block body %}
    <form method="post" action="{{ path('antispam_account_add') }}">
        <input type="hidden" name="_token" value="{{ csrf_token('account_form') }}">
        <div class="panel panel-default">
            <div class="panel-heading"><span class="glyphicon glyphicon-user"></span> Ogólne</div>
            <div class="panel-body">
                <div class="form-group">
                    <label for="accName">Nazwa konta</label>
                    <input type="text" class="form-control" id="accName" name="account[name]" placeholder="np. Moja domena" required>
                </div>
                <div class="form-group">
                    <label for="accEmail">E-mail</label>
                    <input type="email" class="form-control" id="accEmail" name="account[email]" placeholder="user@example.com" required>
                </div>
                <div class="form-group">
                    <label for="connectionType">Typ połączenia</label>
                    <select class="form-control" name="account[connection_type]" id="connectionType">
                        <option value="imap">IMAP</option>
                        <option value="ssh">SSH + Maildir</option>
                    </select>
                </div>
                <div class="form-group">
                    <label><input type="checkbox" name="account[delete_spam]" value="1"> Usuwaj spam (zamiast przenosić do folderu SPAM)</label>
                </div>
            </div>
        </div>

        <div id="imapFields" class="panel panel-default">
            <div class="panel-heading"><span class="glyphicon glyphicon-cloud"></span> Ustawienia IMAP</div>
            <div class="panel-body">
                {% include '@Antispam/Account/_imap_auth.html.twig' with {account: null} %}
                <div class="form-group">
                    <label for="imapHost">Host IMAP</label>
                    <input type="text" class="form-control" id="imapHost" name="account[imap_host]" placeholder="mail.example.com">
                    <p class="help-block" data-auth-show="oauth">Dla OAuth puste pole = serwer dostawcy (<code>outlook.office365.com</code> / <code>imap.gmail.com</code>, port 993, SSL/TLS). Po zapisaniu otwórz edycję konta i kliknij <strong>Połącz</strong>.</p>
                </div>
                <div class="form-group">
                    <label for="imapPort">Port IMAP</label>
                    <input type="number" class="form-control" id="imapPort" name="account[imap_port]" value="993">
                </div>
                <div class="form-group">
                    <label for="imapLogin">Login</label>
                    <input type="text" class="form-control" id="imapLogin" name="account[imap_login]">
                </div>
                <div class="form-group" data-auth-show="password">
                    <label for="imapPassword">Hasło</label>
                    <input type="password" class="form-control" id="imapPassword" name="account[imap_password]">
                </div>
                {% include '@Antispam/Account/_imap_security.html.twig' %}
            </div>
        </div>

        <div id="sshFields" class="panel panel-default" style="display:none;">
            <div class="panel-heading"><span class="glyphicon glyphicon-console"></span> Ustawienia SSH + Maildir</div>
            <div class="panel-body">
                <div class="form-group">
                    <label for="sshHost">Host SSH</label>
                    <input type="text" class="form-control" id="sshHost" name="account[ssh_host]" placeholder="hosting.example.com">
                </div>
                <div class="form-group">
                    <label for="sshPort">Port SSH</label>
                    <input type="number" class="form-control" id="sshPort" name="account[ssh_port]" value="22">
                </div>
                <div class="form-group">
                    <label for="sshUser">Użytkownik SSH</label>
                    <input type="text" class="form-control" id="sshUser" name="account[ssh_user]">
                </div>
                <div class="form-group">
                    <label for="sshKeyPath">Klucz SSH (plik w katalogu kluczy na tym serwerze)</label>
                    <input type="text" class="form-control" id="sshKeyPath" name="account[ssh_key_path]" placeholder="id_ed25519">
                </div>
                <div class="form-group">
                    <label for="maildirPath">Ścieżka Maildir (na hostingu)</label>
                    <input type="text" class="form-control" id="maildirPath" name="account[maildir_path]" value="~/Maildir">
                </div>
                <div class="form-group">
                    <label for="agentPath">Ścieżka agenta (na hostingu)</label>
                    <input type="text" class="form-control" id="agentPath" name="account[agent_path]" value="~/antispam-agent">
                </div>
            </div>
        </div>

        <div class="panel panel-default">
            <div class="panel-heading"><span class="glyphicon glyphicon-download-alt"></span> Wtyczki pocztowe (Thunderbird, Outlook)</div>
            <div class="panel-body">
                <p class="text-muted">Właściciel skrzynki loguje się we wtyczce (Thunderbird, Outlook) tym adresem e-mail i hasłem poniżej albo (konta IMAP) hasłem IMAP. Zalogowany użytkownik może mieć sprawdzaną nową pocztę, a jego zgłoszenia spam / nie-spam tworzą reguły dla tego konta. Pobierz: <a href="{{ path('antispam_plugin_download', {v: constant('AntispamBundle\\Controller\\PluginApiController::PLUGIN_VERSION')}) }}">antispam-thunderbird.xpi</a>, <a href="{{ path('antispam_plugin_config') }}">dodatek Outlook i inne</a>.</p>
                <div class="form-group">
                    <label for="pluginPassword">Hasło wtyczki</label>
                    <input type="password" class="form-control" id="pluginPassword" name="account[plugin_password]" value="" autocomplete="new-password">
                </div>
            </div>
        </div>

        <button type="submit" class="btn btn-primary"><span class="glyphicon glyphicon-floppy-disk"></span> Zapisz</button>
        <a href="{{ path('antispam_account_index') }}" class="btn btn-default">Anuluj</a>
    </form>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('bundles/antispam/js/imap-security.js') }}"></script>
    <script src="{{ asset('bundles/antispam/js/form-toggles.js') }}"></script>
{% endblock %}
