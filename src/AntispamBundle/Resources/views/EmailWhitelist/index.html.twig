{% extends '@Antispam/main.html.twig' %}
{% block title %}Whitelista e-mail{% endblock %}
{% block page_title %}Whitelista adresów e-mail{% endblock %}

{% block body %}
    <div class="add-form">
        <form method="post" action="{{ path('antispam_emailwhitelist_add') }}" class="form-inline">
            <input type="text" class="form-control" name="email" placeholder="znajomy@example.com lub *@zaufana.example" required style="min-width:280px;">
            <select name="pattern_type" class="form-control">
                <option value="exact">Dokładny</option>
                <option value="wildcard">Wildcard</option>
                <option value="regex">Regex</option>
            </select>
            <button type="submit" class="btn btn-success"><span class="glyphicon glyphicon-plus"></span> Dodaj</button>
        </form>
    </div>

    {% if list|length > 0 %}
    <ul class="list-group">
        {% for l in list %}
        <li class="list-group-item">
            <a href="{{ path('antispam_emailwhitelist_del',{'id':l.id}) }}" class="btn btn-danger btn-xs list-actions" onclick="return confirm('Usunąć ten adres z whitelisty?')">
                <span class="glyphicon glyphicon-remove"></span> Usuń
            </a>
            <span class="badge badge-counter">{{ l.counter }} trafień</span>
            <span class="label label-default">{{ l.patternType }}</span>
            <span class="glyphicon glyphicon-envelope"></span> {{ l.whitelistemail }}
        </li>
        {% endfor %}
    </ul>
    {% else %}
    <div class="empty-state">
        <span class="glyphicon glyphicon-ok-circle"></span>
        <p>Whitelista adresów e-mail jest pusta</p>
        <p class="text-muted">Obsługuje wzorce dokładne, wildcard i regex</p>
    </div>
    {% endif %}
{% endblock %}
