<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Logowanie &middot; antispam by pancernapanda.pl</title>
    <style>
        * { box-sizing: border-box; }
        body {
            margin: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            background: linear-gradient(135deg, #000000 0%, #12153d 35%, #1a1d4e 100%);
            color: #1f2a44;
            display: flex;
            min-height: 100vh;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }
        .login-box {
            width: 100%;
            max-width: 400px;
            padding: 36px 32px;
            background: #ffffff;
            border: 1px solid #d5dbef;
            border-radius: 10px;
            border-top: 4px solid #e21d2c;
            box-shadow: 0 18px 50px rgba(0, 0, 0, 0.45);
        }
        .pp-login-logo {
            display: flex;
            justify-content: center;
            margin-bottom: 14px;
        }
        .pp-login-logo svg {
            width: 84px;
            height: 92px;
            filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.35));
        }
        .login-box h1 {
            margin: 0 0 6px;
            font-size: 24px;
            text-align: center;
            color: #1a1d4e;
            font-weight: 800;
            letter-spacing: 1.5px;
            text-transform: uppercase;
        }
        .login-box .subtitle {
            margin: 0 0 24px;
            text-align: center;
            color: #2966e8;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 3px;
            font-weight: 600;
        }
        .form-group { margin-bottom: 16px; }
        .form-group label {
            display: block;
            margin-bottom: 6px;
            font-size: 14px;
            font-weight: 600;
            color: #1a1d4e;
        }
        .form-control {
            display: block;
            width: 100%;
            padding: 9px 12px;
            font-size: 14px;
            line-height: 1.5;
            color: #1f2a44;
            background-color: #ffffff;
            border: 1px solid #c5cce4;
            border-radius: 6px;
            transition: border-color 0.15s, box-shadow 0.15s;
        }
        .form-control:focus {
            border-color: #2966e8;
            outline: 0;
            box-shadow: 0 0 0 3px rgba(41, 102, 232, 0.18);
        }
        .btn-primary {
            display: block;
            width: 100%;
            padding: 11px 16px;
            margin-top: 6px;
            font-size: 14px;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: #ffffff;
            background-color: #e21d2c;
            border: 1px solid #c2101e;
            border-radius: 6px;
            cursor: pointer;
            transition: background-color 0.15s, transform 0.05s;
        }
        .btn-primary:hover { background-color: #5b1018; }
        .btn-primary:active { transform: translateY(1px); }
        .alert-danger {
            padding: 10px 14px;
            margin-bottom: 16px;
            color: #5b1018;
            background-color: #fdecee;
            border: 1px solid #e21d2c;
            border-radius: 6px;
            font-size: 14px;
        }
    </style>
</head>
<body>
    <div class="login-box">
        <div class="pp-login-logo">
            <svg viewBox="0 0 64 70" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Pancerna Panda">
                <defs>
                    <linearGradient id="ppShieldLogin" x1="0" y1="0" x2="0" y2="1">
                        <stop offset="0%" stop-color="#5a9bff"/>
                        <stop offset="55%" stop-color="#2966e8"/>
                        <stop offset="100%" stop-color="#12153d"/>
                    </linearGradient>
                </defs>
                <path d="M32 2 L60 10 V34 C60 50 47 62 32 68 C17 62 4 50 4 34 V10 Z"
                      fill="url(#ppShieldLogin)" stroke="#ffffff" stroke-width="1.2"/>
                <ellipse cx="20" cy="26" rx="6" ry="7" fill="#0f1230"/>
                <ellipse cx="44" cy="26" rx="6" ry="7" fill="#0f1230"/>
                <circle cx="32" cy="38" r="13" fill="#ffffff"/>
                <ellipse cx="25" cy="38" rx="3.2" ry="4" fill="#0f1230"/>
                <ellipse cx="39" cy="38" rx="3.2" ry="4" fill="#0f1230"/>
                <circle cx="25" cy="38" r="1.2" fill="#ffffff"/>
                <circle cx="39" cy="38" r="1.2" fill="#ffffff"/>
                <ellipse cx="32" cy="44" rx="2" ry="1.4" fill="#0f1230"/>
                <path d="M28.5 47 Q32 50 35.5 47" stroke="#0f1230" stroke-width="1.3" fill="none" stroke-linecap="round"/>
            </svg>
        </div>
        <h1>antispam</h1>
        <p class="subtitle">by pancernapanda.pl</p>

        {% if error %}
            <div class="alert-danger">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        <form action="{{ path('login') }}" method="post">
            <div class="form-group">
                <label for="inputUsername">Username</label>
                <input type="text" id="inputUsername" name="_username" value="{{ last_username }}" class="form-control" autofocus required>
            </div>
            <div class="form-group">
                <label for="inputPassword">Password</label>
                <input type="password" id="inputPassword" name="_password" class="form-control" required>
            </div>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
            <button type="submit" class="btn-primary">Sign in</button>
        </form>
    </div>
</body>
</html>
