{% extends '@Antispam/main.html.twig' %}
{% block title %}Weryfikacja dwuetapowa{% endblock %}
{% block page_title %}Weryfikacja dwuetapowa{% endblock %}

{% block body %}
    {% set totp = totp is defined ? totp : true %}
    {% set yubikey = yubikey|default(false) %}
    <form method="post" action="{{ path('antispam_2fa_verify') }}" style="max-width:480px;" autocomplete="off">
        <input type="hidden" name="_token" value="{{ csrf_token('two_factor_verify') }}">
        <div class="panel panel-default">
            <div class="panel-heading"><span class="glyphicon glyphicon-{{ yubikey and not totp ? 'flash' : 'phone' }}"></span> {{ yubikey and not totp ? 'Klucz YubiKey' : 'Kod z aplikacji uwierzytelniającej' }}</div>
            <div class="panel-body">
                <p>Hasło jest poprawne.
                    {% if totp %}Wpisz 6-cyfrowy kod z aplikacji (Google Authenticator, Microsoft Authenticator, Aegis...){% if backup_allowed %} albo jeden z kodów zapasowych{% endif %}{% if yubikey %} - albo kliknij w pole i dotknij klucza YubiKey{% endif %}.
                    {% else %}Włóż klucz YubiKey, kliknij w pole poniżej i dotknij przycisku na kluczu.{% endif %}</p>
                <div class="form-group">
                    <label for="code">{{ totp ? 'Kod' : 'Kod z klucza' }}</label>
                    <input type="text" class="form-control pp-mono" id="code" name="code" inputmode="{{ totp and not backup_allowed and not yubikey ? 'numeric' : 'text' }}" autocomplete="one-time-code" maxlength="{{ yubikey ? 64 : 16 }}" required autofocus>
                </div>
                <button type="submit" class="btn btn-primary"><span class="glyphicon glyphicon-log-in"></span> Potwierdź</button>
                <a href="{{ path('logout') }}" class="btn btn-link">Wyloguj</a>
            </div>
        </div>
    </form>
{% endblock %}
