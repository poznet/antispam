{% extends '@Antispam/main.html.twig' %}

{# User-area page of an own quarantine purge job (MyController::jobAction); the admin job pages (/jobs) stay admin-only. #}
{% block title %}{{ job.typeLabel }}{% endblock %}
{% block page_title %}{{ job.label }}{% endblock %}

{% block body %}
    {% set status_class = {queued: 'default', running: 'info', done: 'success', failed: 'danger', cancelled: 'warning'} %}

    <div class="panel panel-default" id="jobStatus"
         data-job-status-url="{{ path('antispam_my_job_status', {id: job.id}) }}"
         data-job-active="{{ job.active ? '1' : '0' }}">
        <div class="panel-body">
            <p style="margin-bottom:10px;">
                <span class="label label-{{ status_class[job.status] ?? 'default' }}" data-job-field="status_label">{{ job.statusLabel }}</span>
                <strong style="margin-left:6px;">{{ job.typeLabel }}</strong>
                {% if job.mailbox %}<span class="text-muted"> &middot; {{ job.mailbox }}</span>{% endif %}
            </p>

            {% if job.active %}
                <p data-job-field="progress">{{ job.progress ?: (job.status == 'queued' ? 'Czeka na wolny proces w tle...' : 'Trwa...') }}</p>
                <div class="progress job-progress"{{ job.percent is null ? ' style="display:none;"' : '' }} data-job-field="bar-wrap">
                    <div class="progress-bar progress-bar-striped active" role="progressbar" data-job-field="bar"
                         aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ job.percent ?? 0 }}" style="width: {{ job.percent ?? 0 }}%;"></div>
                    <span class="job-progress-label" data-job-field="bar-label">{{ job.percentLabel ?? '0%' }}</span>
                </div>
                <p class="text-muted small">Usuwanie wykonuje się w tle - ta strona odświeży się sama, możesz ją też zamknąć.</p>
                {% if job.cancelRequested %}
                    <p class="text-warning">Anulowanie zgłoszone - zadanie zatrzyma się przy najbliższej okazji.</p>
                {% else %}
                    <form method="post" action="{{ path('antispam_my_job_cancel', {id: job.id}) }}" style="display:inline;">
                        <input type="hidden" name="_token" value="{{ csrf_token('my_job_cancel_' ~ job.id) }}">
                        <button type="submit" class="btn btn-default btn-sm" data-confirm="Anulować to zadanie? Wiadomości już usunięte nie wrócą."><span class="glyphicon glyphicon-stop"></span> Anuluj</button>
                    </form>
                {% endif %}
            {% endif %}

            <table class="table table-condensed" style="margin:10px 0 0;">
                <tr><th style="width:180px;">Dodane</th><td>{{ job.createdAt|date('Y-m-d H:i:s') }}</td></tr>
                {% if job.finishedAt %}<tr><th>Koniec</th><td>{{ job.finishedAt|date('Y-m-d H:i:s') }}</td></tr>{% endif %}
            </table>
        </div>
    </div>

    {% if job.status == 'failed' %}
        <div class="alert alert-danger"><strong>Usuwanie nie powiodło się.</strong>
            {% if is_admin %}{{ job.error }}{% else %}Spróbuj ponownie później lub skontaktuj się z administratorem.{% endif %}
        </div>
    {% elseif job.status == 'cancelled' %}
        <div class="alert alert-warning">Zadanie anulowane.</div>
    {% endif %}

    {% if result is not null and job.finished %}
        {% include '@Antispam/Job/result/quarantine.purge.html.twig' %}
    {% endif %}

    <p style="margin-top:15px;">
        <a href="{{ path('antispam_my_quarantine') }}" class="btn btn-default"><span class="glyphicon glyphicon-arrow-left"></span> Powrót do kwarantanny</a>
    </p>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('bundles/antispam/js/job-status.js') }}"></script>
{% endblock %}
