{
  "manifest_version": 2,
  "name": "Pancernapanda Antyspam",
  "version": "1.0.0",
  "description": "Zgłaszaj spam do Pancernapanda Antyspam i sprawdzaj nową pocztę na serwerze antyspamu.",
  "author": "Pancernapanda",
  "browser_specific_settings": {
    "gecko": {
      "id": "antispam@pancernapanda.pl",
      "strict_min_version": "115.0"
    }
  },
  "icons": {
    "32": "icons/icon.svg",
    "64": "icons/icon.svg"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "permissions": [
    "accountsRead",
    "messagesRead",
    "messagesMove",
    "messagesUpdate",
    "menus",
    "notifications",
    "storage"
  ],
  "optional_permissions": [
    "*://*/*"
  ],
  "message_display_action": {
    "default_title": "Zgłoś spam (Antyspam)",
    "default_icon": "icons/icon.svg"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false,
    "browser_style": false
  }
}
