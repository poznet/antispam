{% extends '@Antispam/main.html.twig' %}
{% block title %}Kwarantanna{% endblock %}
{% block page_title %}Kwarantanna{% endblock %}

{% block body %}
    <p class="text-muted">Wiadomości, których wynik spamu mieści się między progiem kwarantanny a progiem spamu.</p>

    {% set token = csrf_token('quarantine_action') %}
    {% set purge_token = csrf_token('quarantine_purge') %}

    {% set all_high_risk = mailboxes|reduce((sum, m) => sum + m.high_risk_count, 0) %}
    {% if mailboxes|length > 1 and all_high_risk > 0 %}
    <form method="post" action="{{ path('antispam_spambox_quarantine_purge_all') }}" class="text-right" style="margin-bottom:10px;">
        <input type="hidden" name="_token" value="{{ purge_token }}">
        <button type="submit" class="btn btn-sm btn-warning"
                data-confirm="Trwale usunąć wiadomości wysokiego ryzyka z kwarantanny WSZYSTKICH skrzynek ({{ mailboxes|length }})? Na listach: {{ all_high_risk }}. Każda skrzynka to osobne zadanie w tle; ryzyko zostanie sprawdzone ponownie w chwili usuwania. Usuniętych wiadomości nie da się odzyskać.">
            <span class="glyphicon glyphicon-fire" aria-hidden="true"></span> Usuń wszystkie wysokiego ryzyka (wszystkie skrzynki)
        </button>
    </form>
    {% endif %}

    {% for mailbox in mailboxes %}
    <div class="panel panel-default">
        <div class="panel-heading">
            <span class="glyphicon glyphicon-inbox"></span> {{ mailbox.label }}
            <span class="badge pull-right">{{ mailbox.items|length }}</span>
        </div>
        {% if mailbox.error %}
            <div class="panel-body">
                <div class="alert alert-danger" style="margin:0;">Nie udało się odczytać kwarantanny: {{ mailbox.error }}</div>
            </div>
        {% elseif mailbox.items|length > 0 %}
        <div class="table-responsive">
        <table class="table table-striped" style="margin-bottom:0;">
            <thead><tr><th>Data</th><th>Nadawca</th><th>Temat</th><th>Punkty</th><th>Powód</th><th></th></tr></thead>
            <tbody>
            {% for item in mailbox.items %}
                <tr>
                    <td class="pp-cell-nowrap">{{ item.date ? item.date|date('Y-m-d H:i') : '—' }}</td>
                    <td class="pp-cell-wrap">{% if item.from_name %}{{ item.from_name }}<br>{% endif %}<small>{{ item.from }}</small></td>
                    <td class="pp-cell-wrap" title="{{ item.subject }}">{{ item.subject|length > 80 ? item.subject[:80] ~ '…' : item.subject }}</td>
                    <td>{% if item.score is not null %}<strong>{{ item.score }}</strong>{% endif %}</td>
                    <td>
                        {% if item.high_risk %}<span class="label label-danger">wysokie ryzyko</span><br>{% endif %}
                        {% for label in item.labels %}<small>{{ label }}</small><br>{% endfor %}
                    </td>
                    <td class="text-right pp-cell-nowrap">
                        <form method="post" action="{{ path('antispam_spambox_quarantine_action') }}" style="display:inline;">
                            <input type="hidden" name="_token" value="{{ token }}">
                            <input type="hidden" name="mailbox" value="{{ mailbox.key }}">
                            <input type="hidden" name="id" value="{{ item.id }}">
                            <button type="submit" name="action" value="release" class="btn btn-xs btn-success" title="Przywróć do skrzynki odbiorczej">
                                <span class="glyphicon glyphicon-ok" aria-hidden="true"></span> Przywróć
                            </button>
                            {% if not item.high_risk %}
                            <button type="submit" name="action" value="whitelist" class="btn btn-xs btn-info" title="Przywróć do skrzynki i dodaj nadawcę do białej listy">
                                <span class="glyphicon glyphicon-star" aria-hidden="true"></span> Zawsze akceptuj
                            </button>
                            {% endif %}
                            <button type="submit" name="action" value="delete" class="btn btn-xs btn-danger" title="Usuń trwale" aria-label="Usuń trwale" data-confirm="Usunąć wiadomość na stałe?">
                                <span class="glyphicon glyphicon-trash" aria-hidden="true"></span>
                            </button>
                        </form>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
        </div>
        {% include '@Antispam/Spambox/_purge_buttons.html.twig' with {mailbox: mailbox, purge_path: path('antispam_spambox_quarantine_purge'), purge_token: purge_token} only %}
        {% else %}
            <div class="panel-body text-muted">Kwarantanna jest pusta</div>
        {% endif %}
    </div>
    {% else %}
    <div class="empty-state">
        <span class="glyphicon glyphicon-ok-circle"></span>
        <p>Brak skrzynek z kwarantanną</p>
        <p class="text-muted">Skonfiguruj konto IMAP w <a href="{{ path('antispam_account_config') }}">ustawieniach poczty</a> albo wdróż agenta na <a href="{{ path('antispam_account_index') }}">koncie SSH</a>.</p>
    </div>
    {% endfor %}

    <div class="panel panel-default">
        <div class="panel-heading"><span class="glyphicon glyphicon-list-alt"></span> Decyzje „kwarantanna” z ostatnich 30 dni</div>
        <div class="panel-body text-muted" style="padding-bottom:0;">
            <p>Na tej podstawie liczony jest kafelek na pulpicie. To dziennik ocen, nie zawartość folderu: wpis zostaje także wtedy,
            gdy wiadomości nie ma już w kwarantannie. Kolumna <strong>Gdzie teraz</strong> mówi, co się z nią stało.
            Decyzje agentów SSH są zapisywane na serwerze z pocztą, więc tu ich nie ma - ich wiadomości widać w kafelkach powyżej.</p>
        </div>
        {% if logs|length > 0 %}
        <div class="table-responsive">
        <table class="table table-striped" style="margin-bottom:0;">
            <thead><tr><th>Kiedy</th><th>Konto</th><th>Nadawca</th><th>Temat</th><th>Punkty</th><th>Powód</th><th>Gdzie teraz</th></tr></thead>
            <tbody>
            {% for l in logs %}
                {% set loc = locations[l.id] %}
                <tr>
                    <td class="pp-cell-nowrap">{{ l.scoredAt|date('Y-m-d H:i') }}</td>
                    <td class="pp-cell-wrap">{{ l.accountEmail }}</td>
                    <td class="pp-cell-wrap">{{ l.sender }}</td>
                    <td class="pp-cell-wrap" title="{{ l.subject }}">{{ l.subject|length > 60 ? l.subject[:60] ~ '…' : l.subject }}</td>
                    <td><strong>{{ l.score }}</strong></td>
                    <td>
                        {% for r in l.reasonsDecoded %}
                            <small>{{ r.rule }} (+{{ r.score }})</small><br>
                        {% endfor %}
                    </td>
                    <td><span class="label label-{{ loc.class }}" style="white-space:normal;">{{ loc.label }}</span></td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
        </div>
        {% else %}
            <div class="panel-body text-muted">Brak decyzji w dzienniku.</div>
        {% endif %}
    </div>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('bundles/antispam/js/data-confirm.js') }}"></script>
{% endblock %}
