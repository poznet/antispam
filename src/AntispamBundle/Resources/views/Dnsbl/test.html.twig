{% extends '@Antispam/main.html.twig' %}
{% block title %}Sprawdzanie DNSBL{% endblock %}
{% block page_title %}Sprawdzanie IP w DNSBL{% endblock %}

{% block body %}
    <form method="get" action="{{ path('antispam_dnsbl_test') }}" class="form-inline" style="margin-bottom:15px;">
        <input type="text" name="ip" class="form-control" value="{{ ip }}" placeholder="1.2.3.4" style="min-width:220px;">
        <button type="submit" class="btn btn-primary">Sprawdź</button>
        <a href="{{ path('antispam_dnsbl_index') }}" class="btn btn-default">Powrót</a>
    </form>

    {% if ip %}
        <h4>Wyniki dla <code>{{ ip }}</code></h4>
        {% if results|length > 0 %}
        <div class="table-responsive">
        <table class="table table-striped">
            <thead><tr><th>Dostawca</th><th>Strefa</th><th>Na liście</th><th>Odpowiedź</th></tr></thead>
            <tbody>
            {% for r in results %}
                <tr class="{{ r.listed ? 'danger' : '' }}">
                    <td>{{ r.provider.name }}</td>
                    <td><code>{{ r.provider.zone }}</code></td>
                    <td>{% if r.listed %}<span class="label label-danger">TAK</span>{% else %}<span class="label label-success">nie</span>{% endif %}</td>
                    <td><code>{{ r.response|default('-') }}</code></td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
        </div>
        {% else %}
            <p class="text-muted">Brak skonfigurowanych dostawców lub nieprawidłowy adres IP.</p>
        {% endif %}
    {% endif %}
{% endblock %}
