# Default configuration, committed to the repository. Override locally in
# .env.local (not committed) or with real environment variables (Docker).
# Real environment variables always win over these files.

###> symfony/framework-bundle ###
APP_ENV=dev
# Must be a long random string in production (signs sessions, CSRF tokens and
# quarantine digest links). The placeholder below disables the digest links.
APP_SECRET=ChangeMeInProductionPlease
###< symfony/framework-bundle ###

###> admin login ###
ADMIN_USER=admin
# bcrypt/argon hash; generate with: php bin/console security:hash-password
# (the Docker entrypoint derives it from ADMIN_PASSWORD). Empty = login disabled.
ADMIN_PASSWORD_HASH=
# Optional 2FA (TOTP) of this admin: base32 secret from `php bin/console antispam:2fa:secret`.
# Empty = the env admin logs in with the password only (see docs/users.md).
ADMIN_TOTP_SECRET=
###< admin login ###

###> doctrine/doctrine-bundle ###
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=antispam
DATABASE_USER=antispam
DATABASE_PASSWORD=antispam
# e.g. "10.6.0-MariaDB" or "8.0.36" (MySQL)
DATABASE_SERVER_VERSION=10.6.0-MariaDB
###< doctrine/doctrine-bundle ###

###> symfony/mailer ###
# e.g. smtp://user:pass@smtp.example.com:587 ; null://null discards mail
MAILER_DSN=null://null
###< symfony/mailer ###

# Directory holding the SSH private keys of SSH+Maildir accounts
# (empty = var/data/ssh-keys)
SSH_KEYS_DIR=
