# Copy to .env (or paste into Coolify's Environment Variables UI) and adjust.
# The container REFUSES TO START with empty / well-known values for the secrets
# below. Generate strong values with:
#   php -r "echo bin2hex(random_bytes(32));"

# Symfony
APP_SECRET=

# Application login - required to access the web UI
ADMIN_USER=admin
ADMIN_PASSWORD=

# Database (used by both the app and the db service)
DATABASE_NAME=antispam
DATABASE_USER=antispam
DATABASE_PASSWORD=
DATABASE_ROOT_PASSWORD=

# Mailer (optional - leave empty to disable outbound mail)
MAILER_TRANSPORT=smtp
MAILER_HOST=127.0.0.1
MAILER_USER=
MAILER_PASSWORD=

# Set to "false" if you want to manage the schema manually instead of running
# doctrine:schema:update on each boot.
RUN_MIGRATIONS=true

# Local development only — set to 1 to bypass the secret-strength checks at
# container startup. NEVER set in production.
ALLOW_INSECURE_DEFAULTS=0
