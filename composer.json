{
    "name": "pancernapanda/antispam",
    "license": "proprietary",
    "description": "Antispam Pancernapanda - PHP app for cleaning email accounts from spam via IMAP or SSH+Maildir",
    "type": "project",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.2",
        "ext-ctype": "*",
        "ext-curl": "*",
        "ext-iconv": "*",
        "ext-imap": "*",
        "ddeboer/imap": "^1.19",
        "doctrine/dbal": "^4.5",
        "doctrine/doctrine-bundle": "^2.19.2",
        "doctrine/orm": "^3.7.5",
        "phpseclib/phpseclib": "^3.0.57",
        "symfony/asset": "7.4.*",
        "symfony/console": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/filesystem": "7.4.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/mailer": "7.4.*",
        "symfony/monolog-bundle": "^3.11.2",
        "symfony/rate-limiter": "7.4.*",
        "symfony/runtime": "7.4.*",
        "symfony/security-bundle": "7.4.*",
        "symfony/security-csrf": "7.4.*",
        "symfony/translation": "7.4.*",
        "symfony/twig-bundle": "7.4.*",
        "symfony/yaml": "7.4.*",
        "twig/twig": "^3.30"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5.57",
        "symfony/browser-kit": "7.4.*",
        "symfony/debug-bundle": "7.4.*",
        "symfony/web-profiler-bundle": "7.4.*"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "AntispamBundle\\": "src/AntispamBundle/"
        },
        "exclude-from-classmap": [
            "src/AntispamBundle/Tests/",
            "src/AntispamBundle/Resources/"
        ]
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        },
        "bump-after-update": true,
        "sort-packages": true,
        "preferred-install": {
            "*": "dist"
        },
        "platform": {
            "php": "8.2.0"
        }
    },
    "scripts": {
        "auto-scripts": [
            "@php bin/console cache:clear",
            "@php bin/console assets:install public"
        ],
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    }
}
