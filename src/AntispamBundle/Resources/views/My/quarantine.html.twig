{% extends '@Antispam/main.html.twig' %}
{% block title %}Moja kwarantanna{% endblock %}
{% block page_title %}Moja kwarantanna{% endblock %}

{% block body %}
    <p class="text-muted">Wiadomości z Twojej poczty, które filtr uznał za podejrzane, ale nie na tyle, by je usunąć. Jeśli któraś jest wartościowa, przywróć ją do skrzynki odbiorczej.</p>

    {% set token = csrf_token('my_quarantine_action') %}

    {% for mailbox in mailboxes %}
    <div class="panel panel-default">
        <div class="panel-heading">
            <span class="glyphicon glyphicon-inbox"></span> {{ mailbox.label }}
            <span class="badge pull-right">{{ mailbox.items|length }}</span>
        </div>
        {% if mailbox.error %}
            <div class="panel-body">
                <div class="alert alert-danger" style="margin:0;">{{ mailbox.error }}</div>
            </div>
        {% elseif mailbox.items|length > 0 %}
        <div class="table-responsive">
        <table class="table table-striped" style="margin-bottom:0;">
            <thead><tr><th>Data</th><th>Nadawca</th><th>Temat</th><th>Punkty</th><th>Powód</th><th></th></tr></thead>
            <tbody>
            {% for item in mailbox.items %}
                <tr>
                    <td class="pp-cell-nowrap">{{ item.date ? item.date|date('Y-m-d H:i') : '—' }}</td>
                    <td class="pp-cell-wrap">{% if item.from_name %}{{ item.from_name }}<br>{% endif %}<small>{{ item.from }}</small></td>
                    <td class="pp-cell-wrap" title="{{ item.subject }}">{{ item.subject|length > 80 ? item.subject[:80] ~ '…' : item.subject }}</td>
                    <td>{% if item.score is not null %}<strong>{{ item.score }}</strong>{% endif %}</td>
                    <td>
                        {% if item.high_risk %}<span class="label label-danger">wysokie ryzyko</span><br>{% endif %}
                        {% for label in item.labels %}<small>{{ label }}</small><br>{% endfor %}
                    </td>
                    <td class="text-right pp-cell-nowrap">
                        <form method="post" action="{{ path('antispam_my_quarantine_action') }}" style="display:inline;">
                            <input type="hidden" name="_token" value="{{ token }}">
                            <input type="hidden" name="mailbox" value="{{ mailbox.key }}">
                            <input type="hidden" name="id" value="{{ item.id }}">
                            <button type="submit" name="action" value="release" class="btn btn-xs btn-success" title="Przywróć do skrzynki odbiorczej"{% if item.high_risk %} data-confirm="Ta wiadomość ma wysokie ryzyko (phishing / złośliwy załącznik). Na pewno przywrócić ją do skrzynki?"{% endif %}>
                                <span class="glyphicon glyphicon-ok" aria-hidden="true"></span> Przywróć
                            </button>
                            {% if not item.high_risk %}
                            <button type="submit" name="action" value="whitelist" class="btn btn-xs btn-info" title="Przywróć do skrzynki i zawsze przepuszczaj pocztę od tego nadawcy">
                                <span class="glyphicon glyphicon-star" aria-hidden="true"></span> Zawsze akceptuj
                            </button>
                            {% endif %}
                            <button type="submit" name="action" value="delete" class="btn btn-xs btn-danger" title="Usuń trwale" aria-label="Usuń trwale" data-confirm="Usunąć wiadomość na stałe?">
                                <span class="glyphicon glyphicon-trash" aria-hidden="true"></span>
                            </button>
                        </form>
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
        </div>
        {% else %}
            <div class="panel-body text-muted">Kwarantanna jest pusta</div>
        {% endif %}
    </div>
    {% else %}
    <div class="empty-state">
        <span class="glyphicon glyphicon-ok-circle"></span>
        <p>Brak skrzynek z kwarantanną</p>
        <p class="text-muted">Do Twojego konta nie przypisano żadnej skrzynki z kwarantanną. Skontaktuj się z administratorem.</p>
    </div>
    {% endfor %}

    <p class="text-muted">Wiadomości uznane za spam znajdziesz w <a href="{{ path('antispam_my_spam') }}">folderze SPAM</a>, a powody ocen w <a href="{{ path('antispam_my_scorelog', {decision: 'spam'}) }}">dzienniku ocen</a>.</p>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('bundles/antispam/js/data-confirm.js') }}"></script>
{% endblock %}
