{% extends '@Antispam/main.html.twig' %}

{% block title %}Użytkownicy{% endblock %}
{% block page_title %}Użytkownicy panelu{% endblock %}

{% block body %}
    {% set yubikey = yubikey|default(null) %}
    <div class="pp-toolbar">
        <a href="{{ path('antispam_user_add') }}" class="btn btn-primary"><span class="glyphicon glyphicon-plus"></span> Dodaj użytkownika</a>
    </div>

    <p class="text-muted">Administrator widzi wszystko. Użytkownik widzi wyłącznie kwarantannę, spam i dziennik ocen przypisanych mu skrzynek i może przywracać wiadomości z kwarantanny do skrzynki odbiorczej.
    {% if env_admin %}Konto <strong>{{ env_admin }}</strong> pochodzi z konfiguracji serwera (ADMIN_USER) i nie jest tu edytowalne.{% endif %}</p>

    <form method="post" action="{{ path('antispam_user_2fa_policy') }}" class="panel panel-default">
        <div class="panel-body">
            <input type="hidden" name="_token" value="{{ csrf_token('user_2fa_policy') }}">
            <input type="hidden" name="required" value="{{ two_factor_required ? '0' : '1' }}">
            <span class="glyphicon glyphicon-phone"></span>
            <strong>Weryfikacja dwuetapowa (2FA) dla administratorów:</strong>
            {% if two_factor_required %}<span class="label label-success">wymagana</span>{% else %}<span class="label label-default">dobrowolna</span>{% endif %}
            <button type="submit" class="btn btn-xs btn-default" style="margin-left:8px;">{{ two_factor_required ? 'Nie wymagaj' : 'Wymagaj 2FA dla administratorów' }}</button>
            <p class="help-block" style="margin-bottom:0;">Gdy wymagana, administrator bez 2FA po zalogowaniu musi ją najpierw włączyć (menu konta → Weryfikacja dwuetapowa).
            {% if env_admin %}Konto <strong>{{ env_admin }}</strong> z konfiguracji serwera używa 2FA ze zmienną <code>ADMIN_TOTP_SECRET</code> albo z kluczem YubiKey{% if yubikey and yubikey.env_admin_keys|default(0) and yubikey.configured %} (<span class="text-success">klucze: {{ yubikey.env_admin_keys }}</span>){% elseif env_admin_2fa %} (<span class="text-success">ustawiona</span>){% else %} (<span class="text-danger">nieustawiona - to konto loguje się samym hasłem</span>){% endif %}.{% endif %}</p>
        </div>
    </form>

    {% if yubikey %}
    <form method="post" action="{{ path('antispam_user_yubikey_settings') }}" class="panel panel-default" id="yubikey" autocomplete="off">
        <div class="panel-heading">
            <span class="glyphicon glyphicon-flash"></span> Klucze YubiKey (Yubico OTP)
            {% if yubikey.configured %}<span class="label label-success">skonfigurowane</span>{% else %}<span class="label label-default">wyłączone</span>{% endif %}
        </div>
        <div class="panel-body">
            <input type="hidden" name="_token" value="{{ csrf_token('user_yubikey_settings') }}">
            <p class="text-muted">Dane API z <a href="https://upgrade.yubico.com/getapikey/" target="_blank" rel="noopener noreferrer">upgrade.yubico.com/getapikey</a> (darmowe; podajesz e-mail i dotykasz dowolnego klucza YubiKey). Po zapisaniu każdy użytkownik rejestruje swoje klucze w menu konta → <strong>Weryfikacja dwuetapowa</strong>. Zarejestrowany klucz działa jako drugi składnik po haśle (zamiast albo obok kodu z aplikacji). Wbudowane konto <strong>{{ env_admin ?: 'ADMIN_USER' }}</strong> też może mieć klucze (rejestruje je po zalogowaniu na to konto).</p>
            {% if env_admin and yubikey.env_admin_keys|default(0) %}
                <p>Konto <strong>{{ env_admin }}</strong>: zarejestrowanych kluczy <span class="label label-info">{{ yubikey.env_admin_keys }}</span>
                    <button type="submit" form="yk-env-reset" class="btn btn-xs btn-warning" data-confirm="Usunąć wszystkie klucze YubiKey konta {{ env_admin }}? Zaloguje się samym hasłem (+ ADMIN_TOTP_SECRET, jeśli ustawiony)."><span class="glyphicon glyphicon-trash"></span> Usuń klucze tego konta</button></p>
            {% endif %}
            <div class="row">
                <div class="col-sm-4 form-group">
                    <label for="yk-client">Client ID</label>
                    <input type="text" class="form-control pp-mono" id="yk-client" name="client_id" value="{{ yubikey.client_id }}" inputmode="numeric" maxlength="12" placeholder="np. 12345">
                </div>
                <div class="col-sm-8 form-group">
                    <label for="yk-secret">Secret Key</label>
                    <input type="password" class="form-control pp-mono" id="yk-secret" name="secret" autocomplete="new-password" placeholder="{{ yubikey.has_secret ? '•••••••• (zapisany - zostaw puste, aby nie zmieniać)' : 'klucz base64' }}">
                    {% if yubikey.has_secret %}<div class="checkbox" style="margin-bottom:0;"><label><input type="checkbox" name="clear_secret" value="1"> usuń zapisany Secret Key</label></div>{% endif %}
                </div>
            </div>
            <div class="form-group">
                <label for="yk-url">Serwer weryfikacji <span class="text-muted">(opcjonalnie)</span></label>
                <input type="url" class="form-control pp-mono" id="yk-url" name="api_url" value="{{ yubikey.api_url }}" placeholder="{{ yubikey.default_url }}">
                <p class="help-block">Puste = YubiCloud. Własny serwer yubikey-val (protokół 2.0) - tylko https://.</p>
            </div>
            <div class="checkbox">
                <label><input type="checkbox" name="passwordless" value="1"{% if yubikey.passwordless or not yubikey.configured %} checked{% endif %}> <strong>Logowanie samym kluczem</strong> - na stronie logowania przycisk „Zaloguj kluczem YubiKey”: dotknięcie zarejestrowanego klucza loguje bez hasła i bez kodu 2FA</label>
            </div>
            <button type="submit" class="btn btn-primary"><span class="glyphicon glyphicon-floppy-disk"></span> Zapisz</button>
        </div>
    </form>
    {% if env_admin and yubikey.env_admin_keys|default(0) %}
    <form method="post" action="{{ path('antispam_user_env_admin_yubikey_reset') }}" id="yk-env-reset">
        <input type="hidden" name="_token" value="{{ csrf_token('user_env_admin_yubikey_reset') }}">
    </form>
    {% endif %}
    {% endif %}

    <div class="table-responsive">
    <table class="table table-bordered">
        <thead>
            <tr><th>Login</th><th>Rola</th><th>Skrzynki</th><th>2FA</th><th>Utworzono</th><th>Akcje</th></tr>
        </thead>
        <tbody>
        {% for u in users %}
            <tr>
                <td><div class="pp-acct"><span class="pp-acct-ic">{{ u.username|first|upper }}</span><b>{{ u.username }}</b></div></td>
                <td>
                    {% if u.admin %}<span class="label label-danger">Administrator</span>{% else %}<span class="label label-default">Użytkownik</span>{% endif %}
                </td>
                <td>
                    {% if u.admin %}
                        <span class="text-muted">wszystkie</span>
                    {% else %}
                        {% for a in u.accounts %}<span class="label label-info" title="{{ a.email }}">{{ a.name }}</span> {% else %}<span class="text-muted">brak</span>{% endfor %}
                    {% endif %}
                </td>
                {% set yk_count = yubikey ? (yubikey.counts[u.id] ?? 0) : 0 %}
                <td>{% if u.totpEnabled or (yk_count and yubikey.configured) %}<span class="label label-success">włączona</span>{% elseif u.admin and two_factor_required %}<span class="label label-warning">brak (wymagana)</span>{% else %}<span class="text-muted">brak</span>{% endif %}
                    {% if u.totpEnabled %} <span class="label label-default" title="Aplikacja uwierzytelniająca">TOTP</span>{% endif %}
                    {% if yk_count %} <span class="label label-{{ yubikey.configured ? 'info' : 'default' }}" title="{{ yubikey.configured ? 'Zarejestrowane klucze YubiKey' : 'Klucze YubiKey - API nieskonfigurowane, klucze nie działają' }}">YubiKey: {{ yk_count }}</span>{% endif %}</td>
                <td class="pp-mono">{{ u.createdAt|date('Y-m-d H:i') }}</td>
                <td>
                    <form method="post" action="{{ path('antispam_user_del', {id: u.id}) }}" style="margin:0">
                        <input type="hidden" name="_token" value="{{ csrf_token('user_action_' ~ u.id) }}">
                        <div class="btn-group btn-group-xs">
                            <a href="{{ path('antispam_user_edit', {id: u.id}) }}" class="btn btn-default"><span class="glyphicon glyphicon-pencil"></span> Edytuj</a>
                            {% if u.totpEnabled or yk_count %}
                            <button type="submit" formaction="{{ path('antispam_user_2fa_reset', {id: u.id}) }}" class="btn btn-warning" title="Resetuj 2FA (zgubiony telefon / klucz)" data-confirm="Zresetować weryfikację dwuetapową tego użytkownika (aplikacja i wszystkie klucze YubiKey)? Zaloguje się samym hasłem i będzie mógł ją skonfigurować ponownie."><span class="glyphicon glyphicon-phone" aria-hidden="true"></span> Reset 2FA</button>
                            {% endif %}
                            <button type="submit" class="btn btn-danger" title="Usuń" aria-label="Usuń użytkownika" data-confirm="Usunąć tego użytkownika?"><span class="glyphicon glyphicon-trash" aria-hidden="true"></span></button>
                        </div>
                    </form>
                </td>
            </tr>
        {% else %}
            <tr><td colspan="6" class="text-center text-muted" style="padding:40px;">Brak użytkowników &mdash; <a href="{{ path('antispam_user_add') }}">dodaj pierwszego</a></td></tr>
        {% endfor %}
        </tbody>
    </table>
    </div>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('bundles/antispam/js/data-confirm.js') }}"></script>
{% endblock %}
