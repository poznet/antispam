{% extends '@Antispam/main.html.twig' %}
{% import '@Antispam/RuleOwner/macros.html.twig' as owner %}
{% block title %}Whitelista domen{% endblock %}
{% block page_title %}Whitelista domen{% endblock %}

{% block body %}
    <div class="add-form">
        <form method="post" action="{{ path('antispam_whitelist_add') }}" class="form-inline">
            <input type="hidden" name="_token" value="{{ csrf_token('list_rules') }}">
            <input type="text" class="form-control" name="host" placeholder="firma.pl, *.zaufana.example lub regex" required style="min-width:280px;">
            <select name="pattern_type" class="form-control">
                <option value="exact">Dokładny</option>
                <option value="wildcard">Wildcard</option>
                <option value="regex">Regex</option>
            </select>
            {{ owner.select(choices, default_owner, 'rule-owner') }}
            <button type="submit" class="btn btn-success"><span class="glyphicon glyphicon-plus"></span> Dodaj</button>
        </form>
    </div>

    {{ owner.filter('antispam_whitelist_index', owners, owner_filter) }}

    {% if list|length > 0 %}
    {{ owner.bulk_form('antispam_whitelist_make_global_bulk', list, false, owner_filter) }}
    <ul class="list-group">
        {% for l in list %}
        <li class="list-group-item">
            {{ owner.checkbox(l) }}
            <form method="post" action="{{ path('antispam_whitelist_del',{'id':l.id}) }}" style="display:inline;">
                <input type="hidden" name="_token" value="{{ csrf_token('list_rules') }}">
                <button type="submit" class="btn btn-danger btn-xs list-actions" data-confirm="Usunąć tę domenę z whitelisty?"><span class="glyphicon glyphicon-remove"></span> Usuń</button>
            </form>
            {{ owner.global_button('antispam_whitelist_make_global', l, false, owner_filter) }}
            <span class="badge badge-counter">{{ l.counter }} trafień</span>
            <span class="label label-default">{{ l.patternType }}</span>
            <span class="glyphicon glyphicon-globe"></span> {{ l.host }}
            {{ owner.label(l.email) }}
        </li>
        {% endfor %}
    </ul>
    {% else %}
    <div class="empty-state">
        <span class="glyphicon glyphicon-ok-circle"></span>
        <p>Whitelista domen jest pusta</p>
        <p class="text-muted">Obsługuje wzorce dokładne, wildcard i regex</p>
    </div>
    {% endif %}
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('bundles/antispam/js/data-confirm.js') }}"></script>
    <script src="{{ asset('bundles/antispam/js/rule-select.js') }}"></script>
{% endblock %}
