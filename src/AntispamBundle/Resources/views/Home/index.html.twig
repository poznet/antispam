                        </span>
                    </label>
                    <label class="login-field">
                        <span>Hasło</span>
                        <span class="login-input">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
                            <input type="password" name="_password" placeholder="••••••••" autocomplete="current-password" required>
                        </span>
                    </label>
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                    <button type="submit" class="btn btn-primary login-submit">
                        Zaloguj się
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                    </button>
                </form>
            {% endif %}
            <p class="login-secure">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
                Połączenie chronione · Pancerna Panda security toolkit
            </p>
        </aside>
    </div>
</section>

<!-- ============ Audience ============ -->
<section class="section" id="dla-kogo">
    <div class="wrap">
        <div class="section-head center reveal">
            <span class="eyebrow">Dla kogo</span>
            <h2>Od jednej skrzynki do całego hostingu</h2>
        </div>
        <div class="audience">
            <article class="aud reveal">
                <div class="feature-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg></div>
