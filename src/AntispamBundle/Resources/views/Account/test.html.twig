{% extends 'AntispamBundle::main.html.twig' %}

{% block title %}Test połączenia{% if account %}: {{ account.name }}{% endif %}{% endblock %}
{% block page_title %}Test połączenia{% if account %}: {{ account.name }}{% endif %}{% endblock %}

{% block body %}
    {% if result.success %}
        <div class="alert alert-success"><strong>Połączenie udane!</strong></div>
    {% else %}
        <div class="alert alert-danger"><strong>Połączenie nieudane</strong></div>
    {% endif %}

    <ul class="list-group">
    {% for message in result.messages %}
        <li class="list-group-item">{{ message }}</li>
    {% endfor %}
    </ul>

    <a href="{{ path('antispam_account_index') }}" class="btn btn-default"><span class="glyphicon glyphicon-arrow-left"></span> Powrót do kont</a>
{% endblock %}
