{% extends '@Antispam/main.html.twig' %}
{% block title %}Konfiguracja starszego typu{% endblock %}
{% block page_title %}Konfiguracja konta (starszego typu){% endblock %}

{% block body %}
    <div class="alert alert-info">
        <span class="glyphicon glyphicon-info-sign"></span>
        To jest starsza konfiguracja pojedynczego konta. Do zarządzania wieloma kontami użyj sekcji
        <a href="{{ path('antispam_account_index') }}">Konta</a>.
    </div>

    <div class="panel panel-default">
        <div class="panel-heading"><span class="glyphicon glyphicon-envelope"></span> Ustawienia konta IMAP</div>
        <div class="panel-body">
            <form method="post" class="form-horizontal">
                <input type="hidden" name="_token" value="{{ csrf_token('email_config') }}">
                <div class="form-group">
                    <label class="col-sm-3 control-label">E-mail</label>
                    <div class="col-sm-6">
                        <input type="email" class="form-control" name="config[email]" value="{{ config.email }}" placeholder="user@example.com">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-3 control-label">Login</label>
                    <div class="col-sm-6">
                        <input type="text" class="form-control" id="imapLogin" name="config[login]" value="{{ config.login }}">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-3 control-label">Hasło</label>
                    <div class="col-sm-6">
                        <input type="password" class="form-control" id="imapPassword" name="config[password]" value="{{ config.password }}">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-3 control-label">Serwer IMAP</label>
                    <div class="col-sm-6">
                        <input type="text" class="form-control" id="imapHost" name="config[imap]" value="{{ config.imap }}" placeholder="mail.example.com">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-3 control-label">Port IMAP</label>
                    <div class="col-sm-6">
                        <input type="number" class="form-control" id="imapPort" name="config[imap_port]" value="{{ config.imap_port }}">
                    </div>
                </div>
                <div class="form-group">
                    <label class="col-sm-3 control-label">Bezpieczeństwo połączenia</label>
                    <div class="col-sm-9">
                        {% include '@Antispam/Account/_imap_security.html.twig' with {prefix: 'config', imap_flags: config.imap_flags} %}
                    </div>
                </div>
                <div class="form-group">
                    <div class="col-sm-offset-3 col-sm-6">
                        <button type="submit" class="btn btn-primary"><span class="glyphicon glyphicon-floppy-disk"></span> Zapisz</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('bundles/antispam/js/imap-security.js') }}"></script>
{% endblock %}
