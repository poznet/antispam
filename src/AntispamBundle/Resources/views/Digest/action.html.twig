<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <meta name="referrer" content="no-referrer">
    <title>Kwarantanna &middot; Pancernapanda antispam</title>
    <style>
        * { box-sizing: border-box; }
        body {
            margin: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            background: linear-gradient(135deg, #0b2a52 0%, #1e4a8a 55%, #3b82f6 100%);
            color: #1f2a44;
            display: flex; min-height: 100vh; align-items: center; justify-content: center; padding: 20px;
        }
        .box { width: 100%; max-width: 480px; padding: 32px 28px; background: #fff; border: 1px solid #d5e1f2; border-radius: 10px; box-shadow: 0 14px 40px rgba(11, 42, 82, .25); }
        h1 { margin: 0 0 14px; font-size: 20px; }
        .meta { background: #f4f7fc; border: 1px solid #e3eaf5; border-radius: 6px; padding: 10px 12px; font-size: 14px; margin-bottom: 18px; word-break: break-word; }
        .meta div + div { margin-top: 4px; }
        .muted { color: #5b6b85; font-size: 13px; }
        button { width: 100%; padding: 11px; font-size: 15px; font-weight: 600; color: #fff; border: 0; border-radius: 6px; cursor: pointer; }
        .release { background: #1e7e34; } .whitelist { background: #1e4a8a; } .delete { background: #b42318; }
        .ok { color: #1e7e34; } .err { color: #b42318; }
    </style>
</head>
<body>
<div class="box">
    {% if state == 'invalid' %}
        <h1 class="err">Link wygasł lub jest nieprawidłowy</h1>
        <p class="muted">Linki z raportu kwarantanny są ważne przez ograniczony czas. Poczekaj na kolejny raport albo skontaktuj się z administratorem.</p>
    {% else %}
        {% set labels = {
            'release': ['Dostarczyć wiadomość?', 'Dostarcz do skrzynki'],
            'whitelist': ['Dostarczyć i zawsze akceptować tego nadawcę?', 'Dostarcz i dodaj do białej listy'],
            'delete': ['Usunąć wiadomość?', 'Usuń na stałe']
        } %}
        {% if state == 'confirm' %}
            <h1>{{ labels[data.action][0] }}</h1>
        {% else %}
            <h1 class="{{ result.success ? 'ok' : 'err' }}">{{ result.success ? 'Gotowe' : 'Nie udało się' }}</h1>
        {% endif %}

        {% if data.sender or data.subject %}
        <div class="meta">
            {% if data.sender %}<div><strong>Od:</strong> {{ data.sender }}</div>{% endif %}
            {% if data.subject %}<div><strong>Temat:</strong> {{ data.subject }}</div>{% endif %}
        </div>
        {% endif %}

        {% if state == 'confirm' %}
            {% if data.action == 'whitelist' %}
                <p class="muted">Kolejne wiadomości od tego nadawcy nie będą filtrowane.</p>
            {% elseif data.action == 'delete' %}
                <p class="muted">Tej operacji nie można cofnąć.</p>
            {% endif %}
            <form method="post">
                <button type="submit" class="{{ data.action }}">{{ labels[data.action][1] }}</button>
            </form>
        {% else %}
            <p>{{ result.message }}</p>
        {% endif %}
    {% endif %}
</div>
</body>
</html>
