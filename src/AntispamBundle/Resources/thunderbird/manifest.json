{
  "manifest_version": 2,
  "name": "Antispam Pancernapanda",
  "version": "1.3.1",
  "description": "Zgłaszaj spam do Antispam Pancernapanda i sprawdzaj nową pocztę na serwerze antyspamu.",
  "author": "Pancernapanda",
  "browser_specific_settings": {
    "gecko": {
      "id": "antispam@pancernapanda.pl",
      "strict_min_version": "115.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "32": "icons/icon-32.png",
    "64": "icons/icon-64.png"
  },
  "background": {
    "scripts": ["common.js", "background.js"]
  },
  "permissions": [
    "accountsRead",
    "messagesRead",
    "messagesMove",
    "messagesUpdate",
    "menus",
    "notifications",
    "storage"
  ],
  "optional_permissions": [
    "*://*/*"
  ],
  "message_display_action": {
    "default_title": "Zgłoś spam (Antyspam)",
    "default_icon": "icons/icon-64.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true,
    "browser_style": false
  }
}
