{% extends '@Antispam/main.html.twig' %}
{% import '@Antispam/RuleOwner/macros.html.twig' as owner %}
{% block title %}Blacklista domen{% endblock %}
{% block page_title %}Blacklista domen{% endblock %}

{% block body %}
    <div class="add-form">
        <form method="post" action="{{ path('antispam_blacklist_add') }}" class="form-inline">
            <input type="hidden" name="_token" value="{{ csrf_token('list_rules') }}">
            <input type="text" class="form-control" name="host" placeholder="spam-domena.com, *.evil.example lub ^.*\.ru$" required style="min-width:280px;">
            <select name="pattern_type" class="form-control">
                <option value="exact">Dokładny</option>
                <option value="wildcard">Wildcard</option>
                <option value="regex">Regex</option>
            </select>
            <input type="number" class="form-control" name="score" value="10" min="1" max="50" title="Trafienie zawsze oznacza spam; punkty są widoczne w dzienniku ocen" style="width:90px;">
            {{ owner.select(choices, default_owner, 'rule-owner') }}
            <button type="submit" class="btn btn-danger"><span class="glyphicon glyphicon-plus"></span> Dodaj</button>
        </form>
    </div>

    {{ owner.filter('antispam_blacklist_index', owners, owner_filter) }}

    {% if list|length > 0 %}
    {{ owner.bulk_form('antispam_blacklist_make_global_bulk', list, true, owner_filter) }}
    <ul class="list-group">
        {% for l in list %}
        <li class="list-group-item">
            {{ owner.checkbox(l) }}
            <form method="post" action="{{ path('antispam_blacklist_del',{'id':l.id}) }}" style="display:inline;">
                <input type="hidden" name="_token" value="{{ csrf_token('list_rules') }}">
                <button type="submit" class="btn btn-danger btn-xs list-actions" data-confirm="Usunąć tę domenę z blacklisty?"><span class="glyphicon glyphicon-remove"></span> Usuń</button>
            </form>
            {{ owner.global_button('antispam_blacklist_make_global', l, true, owner_filter) }}
            <span class="badge badge-counter">{{ l.counter }} trafień</span>
            <span class="label label-default">{{ l.patternType }}</span>
            <span class="label label-warning">punkty {{ l.score }}</span>
            <span class="glyphicon glyphicon-globe"></span> {{ l.host }}
            {{ owner.label(l.email) }}
        </li>
        {% endfor %}
    </ul>
    {% else %}
    <div class="empty-state">
        <span class="glyphicon glyphicon-ban-circle"></span>
        <p>Blacklista domen jest pusta</p>
        <p class="text-muted">Dodaj domeny powyżej. Użyj <code>*.example.com</code> dla wildcard lub wyrażenia PCRE, np. <code>^mail\d+\.spam$</code>, dla regex.</p>
    </div>
    {% endif %}
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('bundles/antispam/js/data-confirm.js') }}"></script>
    <script src="{{ asset('bundles/antispam/js/rule-select.js') }}"></script>
{% endblock %}
