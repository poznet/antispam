{% extends '@Antispam/main.html.twig' %}

{% block title %}Zadania w tle{% endblock %}
{% block page_title %}Zadania w tle{% endblock %}

{% block body %}
    {% set status_class = {queued: 'default', running: 'info', done: 'success', failed: 'danger', cancelled: 'warning'} %}

    <p class="text-muted">Ciężkie operacje uruchamiane z panelu (skanowanie skrzynek, wdrożenie i synchronizacja agentów, sprawdzanie istniejącej poczty po dodaniu reguły,
    synchronizacja listy CERT, wysyłka raportów) wykonuje proces w tle <code>antispam:jobs:work</code>, a nie żądanie przeglądarki.
    Zakończone zadania są usuwane po {{ retention }} dniach (<code>antispam:purge</code>).</p>

    {% if stats.oldest_queued_at and stats.oldest_queued_at|date('U') < ('now'|date('U') - stuck_minutes * 60) %}
        <div class="alert alert-warning">
            Najstarsze zadanie czeka od {{ stats.oldest_queued_at|date('Y-m-d H:i') }} - proces w tle (<code>antispam:jobs:work</code>) prawdopodobnie nie działa.
            W Dockerze uruchamia go usługa <code>scheduler</code>; bez Dockera dodaj do crontaba <code>* * * * * php bin/console antispam:jobs:run --once</code>.
        </div>
    {% endif %}

    <p>
        <span class="label label-default">w kolejce: {{ stats.queued }}</span>
        <span class="label label-info">w trakcie: {{ stats.running }}</span>
        <span class="label label-{{ stats.failed_24h ? 'danger' : 'success' }}">błędy (24 h): {{ stats.failed_24h }}</span>
    </p>

    <form method="get" class="form-inline" style="margin-bottom:15px;">
        <label for="jobStatusFilter" class="sr-only">Status</label>
        <select name="status" id="jobStatusFilter" class="form-control input-sm">
            <option value="">Wszystkie statusy</option>
            <option value="active" {% if status == 'active' %}selected{% endif %}>Aktywne (w kolejce / trwa)</option>
            {% for key, label in statuses %}
                <option value="{{ key }}" {% if status == key %}selected{% endif %}>{{ label }}</option>
            {% endfor %}
        </select>
        <label for="jobTypeFilter" class="sr-only">Rodzaj</label>
        <select name="type" id="jobTypeFilter" class="form-control input-sm">
            <option value="">Wszystkie rodzaje</option>
            {% for key, label in types %}
                <option value="{{ key }}" {% if type == key %}selected{% endif %}>{{ label }}</option>
            {% endfor %}
        </select>
        <button type="submit" class="btn btn-default btn-sm"><span class="glyphicon glyphicon-filter"></span> Filtruj</button>
    </form>

    {% if jobs|length > 0 %}
    <div class="panel panel-default">
        <div class="table-responsive">
        <table class="table table-striped" style="margin-bottom:0;">
            <thead><tr><th>#</th><th>Dodane</th><th>Zadanie</th><th>Zlecił</th><th>Status</th><th>Czas</th><th></th></tr></thead>
            <tbody>
            {% for job in jobs %}
                <tr>
                    <td><a href="{{ path('antispam_job_show', {id: job.id}) }}">{{ job.id }}</a></td>
                    <td class="pp-cell-nowrap">{{ job.createdAt|date('Y-m-d H:i:s') }}</td>
                    <td class="pp-cell-wrap"><a href="{{ path('antispam_job_show', {id: job.id}) }}">{{ job.label }}</a>
                        {% if job.active and job.progress %}<br><small class="text-muted">{{ job.progress }}</small>{% endif %}
                        {% if job.status == 'failed' and job.error %}<br><small class="text-danger">{{ job.error|length > 160 ? job.error[:160] ~ '…' : job.error }}</small>{% endif %}
                    </td>
                    <td>{{ job.requestedBy ?: '—' }}</td>
                    <td><span class="label label-{{ status_class[job.status] ?? 'default' }}">{{ job.statusLabel }}</span></td>
                    <td>{{ job.duration is not null ? job.duration ~ ' s' : '—' }}</td>
                    <td class="pp-cell-nowrap">
                        {% if job.active %}
                            {% if job.cancelRequested %}
                                <small class="text-warning">przerywanie…</small>
                            {% else %}
                            <form method="post" action="{{ path('antispam_job_cancel', {id: job.id}) }}" style="margin:0">
                                <input type="hidden" name="_token" value="{{ csrf_token('job_cancel_' ~ job.id) }}">
                                <input type="hidden" name="return" value="list">
                                <button type="submit" class="btn btn-default btn-xs" data-confirm="Zakończyć zadanie #{{ job.id }} ({{ job.label }})?{{ job.status == 'running' ? ' Skan zatrzyma się w ciągu kilku sekund; ponowny skan zachowa postęp i można go później wznowić.' : '' }}"><span class="glyphicon glyphicon-stop" aria-hidden="true"></span> Anuluj</button>
                            </form>
                            {% endif %}
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
        </div>
    </div>
    {% else %}
    <div class="empty-state">
        <span class="glyphicon glyphicon-tasks"></span>
        <p>Brak zadań</p>
        <p class="text-muted">Pojawią się tu po kliknięciu np. „Skanuj” na liście kont.</p>
    </div>
    {% endif %}
{% endblock %}
