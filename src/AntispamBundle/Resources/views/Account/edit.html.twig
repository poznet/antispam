{% extends '@Antispam/main.html.twig' %}

{% block title %}Edycja konta: {{ account.name }}{% endblock %}
{% block page_title %}Edycja konta: {{ account.name }}{% endblock %}

{% block body %}
    <form method="post" action="{{ path('antispam_account_edit', {id: account.id}) }}">
        <input type="hidden" name="_token" value="{{ csrf_token('account_form') }}">
        <div class="panel panel-default">
            <div class="panel-heading"><span class="glyphicon glyphicon-user"></span> Ogólne</div>
            <div class="panel-body">
                <div class="form-group">
                    <label for="accName">Nazwa konta</label>
                    <input type="text" class="form-control" id="accName" name="account[name]" value="{{ account.name }}" required>
                </div>
                <div class="form-group">
                    <label for="accEmail">E-mail</label>
                    <input type="email" class="form-control" id="accEmail" name="account[email]" value="{{ account.email }}" required>
                </div>
                <div class="form-group">
                    <label for="connectionType">Typ połączenia</label>
                    <select class="form-control" name="account[connection_type]" id="connectionType">
                        <option value="imap" {% if account.connectionType == 'imap' %}selected{% endif %}>IMAP</option>
                        <option value="ssh" {% if account.connectionType == 'ssh' %}selected{% endif %}>SSH + Maildir</option>
                    </select>
                </div>
            </div>
        </div>

        {% set g = global_settings %}
        {% set max_threshold = constant('AntispamBundle\\Services\\MailboxSettingsResolver::MAX_THRESHOLD') %}
        <div class="panel panel-default" id="mailboxSettings">
            <div class="panel-heading"><span class="glyphicon glyphicon-tasks"></span> Ustawienia skrzynki
                {% if account.hasSettingsOverrides %}<span class="label label-info">własne ustawienia</span>{% endif %}
            </div>
            <div class="panel-body">
                <p class="text-muted">Puste pole = <strong>dziedzicz</strong> wartość globalną (w nawiasie: aktualna wartość z <a href="{{ path('antispam_spam_config') }}">Ustawienia → Filtr spamu</a> i <a href="{{ path('antispam_digest_config') }}">Raport kwarantanny</a>). Obowiązują skan IMAP, agenta SSH (po synchronizacji reguł), sprawdzanie we wtyczkach pocztowych i przenoszenie wstecz po dodaniu reguły blacklisty. Skrzynka z <em>Ustawienia → E-mail</em> (stara konfiguracja) zawsze używa ustawień globalnych.</p>
                <div class="row">
                    <div class="col-sm-6 form-group">
                        <label for="accSpamThreshold">Próg spamu</label>
                        <input type="number" min="1" max="{{ max_threshold }}" class="form-control" id="accSpamThreshold" name="account[spam_threshold]" value="{{ account.spamThreshold }}" placeholder="dziedzicz ({{ g.spamThreshold }})">
                    </div>
                    <div class="col-sm-6 form-group">
                        <label for="accQuarantineThreshold">Próg kwarantanny</label>
                        <input type="number" min="0" max="{{ max_threshold }}" class="form-control" id="accQuarantineThreshold" name="account[quarantine_threshold]" value="{{ account.quarantineThreshold }}" placeholder="dziedzicz ({{ g.quarantineThreshold }})">
                        <p class="help-block">Musi być niższy niż próg spamu (puste pole liczy się jako wartość globalna).</p>
                    </div>
                </div>
                <div class="form-group">
                    <label for="accScoringEnabled">Punktacja (nagłówki, DNSBL, linki, załączniki, podszywanie)</label>
                    <select class="form-control" id="accScoringEnabled" name="account[scoring_enabled]">
                        <option value="" {% if account.scoringEnabled is null %}selected{% endif %}>dziedzicz ({{ g.scoringEnabled ? 'włączona' : 'wyłączona' }})</option>
                        <option value="1" {% if account.scoringEnabled is same as(true) %}selected{% endif %}>włączona</option>
                        <option value="0" {% if account.scoringEnabled is same as(false) %}selected{% endif %}>wyłączona - tylko białe / czarne listy (trafienie w blacklistę = spam)</option>
                    </select>
                </div>
                <div class="form-group">
                    <label><input type="checkbox" name="account[delete_spam]" value="1" {% if account.deleteSpam %}checked{% endif %}> Usuwaj spam (zamiast przenosić do folderu SPAM)</label>
                    <p class="help-block">Tylko konta IMAP, osobno dla każdej skrzynki (bez dziedziczenia). Agent SSH zawsze przenosi spam do <code>~/Maildir/.SPAM</code>.</p>
                </div>
                <hr>
                <div class="row">
                    <div class="col-sm-4 form-group">
                        <label for="accDigestEnabled">Raport kwarantanny</label>
                        <select class="form-control" id="accDigestEnabled" name="account[digest_enabled]">
                            <option value="" {% if account.digestEnabled is null %}selected{% endif %}>dziedzicz ({{ g.digestEnabled ? 'włączony' : 'wyłączony' }})</option>
                            <option value="1" {% if account.digestEnabled is same as(true) %}selected{% endif %}>włączony</option>
                            <option value="0" {% if account.digestEnabled is same as(false) %}selected{% endif %}>wyłączony</option>
                        </select>
                    </div>
                    <div class="col-sm-5 form-group">
                        <label for="accDigestRecipient">Odbiorca raportu</label>
                        <input type="email" class="form-control" id="accDigestRecipient" name="account[digest_recipient]" value="{{ account.digestRecipient }}" placeholder="dziedzicz ({{ account.email }})">
                        <p class="help-block">Np. kierownik działu zamiast właściciela skrzynki.</p>
                    </div>
                    <div class="col-sm-3 form-group">
                        <label for="accDigestHour">Godzina wysyłki</label>
                        <input type="number" min="0" max="23" class="form-control" id="accDigestHour" name="account[digest_hour]" value="{{ account.digestHour }}" placeholder="harmonogram globalny">
                        <p class="help-block">0-23, czas serwera.</p>
                    </div>
                </div>
            </div>
        </div>

        <div id="imapFields" class="panel panel-default" {% if account.connectionType == 'ssh' %}style="display:none;"{% endif %}>
            <div class="panel-heading"><span class="glyphicon glyphicon-cloud"></span> Ustawienia IMAP</div>
            <div class="panel-body">
                <div class="form-group">
                    <label for="imapHost">Host IMAP</label>
                    <input type="text" class="form-control" id="imapHost" name="account[imap_host]" value="{{ account.imapHost }}">
                </div>
                <div class="form-group">
                    <label for="imapPort">Port IMAP</label>
                    <input type="number" class="form-control" id="imapPort" name="account[imap_port]" value="{{ account.imapPort }}">
                </div>
                <div class="form-group">
                    <label for="imapLogin">Login</label>
                    <input type="text" class="form-control" id="imapLogin" name="account[imap_login]" value="{{ account.imapLogin }}">
                </div>
                <div class="form-group">
                    <label for="imapPassword">Hasło</label>
                    <input type="password" class="form-control" id="imapPassword" name="account[imap_password]" value="" placeholder="(bez zmian)" autocomplete="new-password">
                    <p class="help-block">Zostaw puste, żeby zachować obecne hasło.</p>
                </div>
                {% include '@Antispam/Account/_imap_security.html.twig' with {account_id: account.id} %}
            </div>
        </div>

        <div id="sshFields" class="panel panel-default" {% if account.connectionType != 'ssh' %}style="display:none;"{% endif %}>
            <div class="panel-heading"><span class="glyphicon glyphicon-console"></span> Ustawienia SSH + Maildir</div>
            <div class="panel-body">
                <div class="form-group">
                    <label for="sshHost">Host SSH</label>
                    <input type="text" class="form-control" id="sshHost" name="account[ssh_host]" value="{{ account.sshHost }}">
                </div>
                <div class="form-group">
                    <label for="sshPort">Port SSH</label>
                    <input type="number" class="form-control" id="sshPort" name="account[ssh_port]" value="{{ account.sshPort }}">
                </div>
                <div class="form-group">
                    <label for="sshUser">Użytkownik SSH</label>
                    <input type="text" class="form-control" id="sshUser" name="account[ssh_user]" value="{{ account.sshUser }}">
                </div>
                <div class="form-group">
                    <label for="sshKeyPath">Klucz SSH (plik w katalogu kluczy na tym serwerze)</label>
                    <input type="text" class="form-control" id="sshKeyPath" name="account[ssh_key_path]" value="{{ account.sshKeyPath }}">
                </div>
                <div class="form-group">
                    <label for="maildirPath">Ścieżka Maildir (na hostingu)</label>
                    <input type="text" class="form-control" id="maildirPath" name="account[maildir_path]" value="{{ account.maildirPath }}">
                </div>
                <div class="form-group">
                    <label for="agentPath">Ścieżka agenta (na hostingu)</label>
                    <input type="text" class="form-control" id="agentPath" name="account[agent_path]" value="{{ account.agentPath }}">
                </div>
                <div class="form-group">
                    <label>Klucz hosta SSH (zapamiętany przy pierwszym połączeniu)</label>
                    <p class="form-control-static pp-mono">{{ account.sshHostKey ?: 'jeszcze nie zapamiętany' }}</p>
                    <p class="help-block">Zmiana hosta lub portu kasuje zapamiętany klucz. Jeśli serwer zmienił klucz celowo, porównaj odcisk z <code>ssh-keyscan HOST | ssh-keygen -lf -</code> i użyj przycisku „Resetuj klucz hosta” pod formularzem.</p>
                </div>
            </div>
        </div>

        <div class="panel panel-default">
            <div class="panel-heading"><span class="glyphicon glyphicon-download-alt"></span> Wtyczki pocztowe (Thunderbird, Outlook)</div>
            <div class="panel-body">
                <p class="text-muted">Właściciel skrzynki loguje się we wtyczce (Thunderbird, Outlook) tym adresem e-mail i hasłem poniżej albo (konta IMAP) hasłem IMAP. Zalogowany użytkownik może mieć sprawdzaną nową pocztę, a jego zgłoszenia spam / nie-spam tworzą reguły dla tego konta. Pobierz: <a href="{{ path('antispam_plugin_download', {v: constant('AntispamBundle\\Controller\\PluginApiController::PLUGIN_VERSION')}) }}">antispam-thunderbird.xpi</a>, <a href="{{ path('antispam_plugin_config') }}">dodatek Outlook i inne</a>.</p>
                {% if account.pluginPasswordHash %}
                    <p class="text-success"><span class="glyphicon glyphicon-ok"></span> Hasło wtyczki jest ustawione. Zostaw pole puste, aby go nie zmieniać.</p>
                    <div class="checkbox"><label><input type="checkbox" name="account[plugin_password_clear]" value="1"> Usuń hasło wtyczki</label></div>
                {% endif %}
                <div class="form-group">
                    <label for="pluginPassword">Hasło wtyczki</label>
                    <input type="password" class="form-control" id="pluginPassword" name="account[plugin_password]" value="" autocomplete="new-password">
                </div>
            </div>
        </div>

        <button type="submit" class="btn btn-primary"><span class="glyphicon glyphicon-floppy-disk"></span> Zapisz</button>
        <a href="{{ path('antispam_account_index') }}" class="btn btn-default">Anuluj</a>
    </form>

    {% if account.sshHostKey %}
    <form method="post" action="{{ path('antispam_account_reset_host_key', {id: account.id}) }}" style="margin-top:15px">
        <input type="hidden" name="_token" value="{{ csrf_token('account_action_' ~ account.id) }}">
        <button type="submit" class="btn btn-warning btn-sm"><span class="glyphicon glyphicon-refresh"></span> Resetuj klucz hosta SSH</button>
    </form>
    {% endif %}

{% endblock %}

{% block javascripts %}
    <script src="{{ asset('bundles/antispam/js/imap-security.js') }}"></script>
    <script src="{{ asset('bundles/antispam/js/form-toggles.js') }}"></script>
{% endblock %}
