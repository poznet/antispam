{% extends '@Antispam/main.html.twig' %}

{% block title %}Edycja konta: {{ account.name }}{% endblock %}
{% block page_title %}Edycja konta: {{ account.name }}{% endblock %}

{% block body %}
    <form method="post" action="{{ path('antispam_account_edit', {id: account.id}) }}">
        <input type="hidden" name="_token" value="{{ csrf_token('account_form') }}">
        <div class="panel panel-default">
            <div class="panel-heading"><span class="glyphicon glyphicon-user"></span> Ogólne</div>
            <div class="panel-body">
                <div class="form-group">
                    <label>Nazwa konta</label>
                    <input type="text" class="form-control" name="account[name]" value="{{ account.name }}" required>
                </div>
                <div class="form-group">
                    <label>E-mail</label>
                    <input type="email" class="form-control" name="account[email]" value="{{ account.email }}" required>
                </div>
                <div class="form-group">
                    <label>Typ połączenia</label>
                    <select class="form-control" name="account[connection_type]" id="connectionType" onchange="toggleFields()">
                        <option value="imap" {% if account.connectionType == 'imap' %}selected{% endif %}>IMAP</option>
                        <option value="ssh" {% if account.connectionType == 'ssh' %}selected{% endif %}>SSH + Maildir</option>
                    </select>
                </div>
                <div class="form-group">
                    <label><input type="checkbox" name="account[delete_spam]" value="1" {% if account.deleteSpam %}checked{% endif %}> Usuwaj spam (zamiast przenosić do folderu SPAM)</label>
                </div>
            </div>
        </div>

        <div id="imapFields" class="panel panel-default" {% if account.connectionType == 'ssh' %}style="display:none;"{% endif %}>
            <div class="panel-heading"><span class="glyphicon glyphicon-cloud"></span> Ustawienia IMAP</div>
            <div class="panel-body">
                <div class="form-group">
                    <label>Host IMAP</label>
                    <input type="text" class="form-control" name="account[imap_host]" value="{{ account.imapHost }}">
                </div>
                <div class="form-group">
                    <label>Port IMAP</label>
                    <input type="number" class="form-control" name="account[imap_port]" value="{{ account.imapPort }}">
                </div>
                <div class="form-group">
                    <label>Login</label>
                    <input type="text" class="form-control" name="account[imap_login]" value="{{ account.imapLogin }}">
                </div>
                <div class="form-group">
                    <label>Hasło</label>
                    <input type="password" class="form-control" name="account[imap_password]" value="" placeholder="(bez zmian)" autocomplete="new-password">
                    <p class="help-block">Zostaw puste, żeby zachować obecne hasło.</p>
                </div>
                <div class="form-group">
                    <label>Flagi IMAP</label>
                    <input type="text" class="form-control" name="account[imap_flags]" value="{{ account.imapFlags }}">
                </div>
            </div>
        </div>

        <div id="sshFields" class="panel panel-default" {% if account.connectionType != 'ssh' %}style="display:none;"{% endif %}>
            <div class="panel-heading"><span class="glyphicon glyphicon-console"></span> Ustawienia SSH + Maildir</div>
            <div class="panel-body">
                <div class="form-group">
                    <label>Host SSH</label>
                    <input type="text" class="form-control" name="account[ssh_host]" value="{{ account.sshHost }}">
                </div>
                <div class="form-group">
                    <label>Port SSH</label>
                    <input type="number" class="form-control" name="account[ssh_port]" value="{{ account.sshPort }}">
                </div>
                <div class="form-group">
                    <label>Użytkownik SSH</label>
                    <input type="text" class="form-control" name="account[ssh_user]" value="{{ account.sshUser }}">
                </div>
                <div class="form-group">
                    <label>Klucz SSH (plik w katalogu kluczy na tym serwerze)</label>
                    <input type="text" class="form-control" name="account[ssh_key_path]" value="{{ account.sshKeyPath }}">
                </div>
                <div class="form-group">
                    <label>Ścieżka Maildir (na hostingu)</label>
                    <input type="text" class="form-control" name="account[maildir_path]" value="{{ account.maildirPath }}">
                </div>
                <div class="form-group">
                    <label>Ścieżka agenta (na hostingu)</label>
                    <input type="text" class="form-control" name="account[agent_path]" value="{{ account.agentPath }}">
                </div>
            </div>
        </div>

        <div class="panel panel-default">
            <div class="panel-heading"><span class="glyphicon glyphicon-download-alt"></span> Wtyczka Thunderbird</div>
            <div class="panel-body">
                <p class="text-muted">Właściciel skrzynki loguje się we wtyczce Thunderbirda tym adresem e-mail i hasłem poniżej albo (konta IMAP) hasłem IMAP. Zalogowany użytkownik może mieć sprawdzaną nową pocztę, a jego zgłoszenia spam / nie-spam tworzą reguły dla tego konta. Pobierz: <a href="{{ path('antispam_plugin_download') }}">antispam-thunderbird.xpi</a>.</p>
                {% if account.pluginPasswordHash %}
                    <p class="text-success"><span class="glyphicon glyphicon-ok"></span> Hasło wtyczki jest ustawione. Zostaw pole puste, aby go nie zmieniać.</p>
                    <div class="checkbox"><label><input type="checkbox" name="account[plugin_password_clear]" value="1"> Usuń hasło wtyczki</label></div>
                {% endif %}
                <div class="form-group">
                    <label>Hasło wtyczki</label>
                    <input type="password" class="form-control" name="account[plugin_password]" value="" autocomplete="new-password">
                </div>
            </div>
        </div>

        <button type="submit" class="btn btn-primary"><span class="glyphicon glyphicon-floppy-disk"></span> Zapisz</button>
        <a href="{{ path('antispam_account_index') }}" class="btn btn-default">Anuluj</a>
    </form>

    <script>
    function toggleFields() {
        var type = document.getElementById('connectionType').value;
        document.getElementById('imapFields').style.display = type === 'imap' ? 'block' : 'none';
        document.getElementById('sshFields').style.display = type === 'ssh' ? 'block' : 'none';
    }
    </script>
{% endblock %}
