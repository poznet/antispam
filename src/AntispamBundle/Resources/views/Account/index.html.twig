{% extends '@Antispam/main.html.twig' %}

{% block title %}Konta{% endblock %}
{% block page_title %}Konta pocztowe{% endblock %}

{% block body %}
    <div class="pp-toolbar">
        <a href="{{ path('antispam_account_add') }}" class="btn btn-primary"><span class="glyphicon glyphicon-plus"></span> Dodaj konto</a>
        <span class="pp-spacer"></span>
        <a href="{{ path('antispam_account_download_agent') }}" class="btn btn-default"><span class="glyphicon glyphicon-download-alt"></span> Pobierz agenta</a>
    </div>

    <div class="table-responsive">
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Nazwa</th>
                <th>E-mail</th>
                <th>Typ</th>
                <th>Host</th>
                <th>Agent</th>
                <th>Ostatni skan</th>
                <th>Akcje</th>
            </tr>
        </thead>
        <tbody>
        {% for account in accounts %}
            <tr>
                <td><div class="pp-acct"><span class="pp-acct-ic">{{ account.name|first }}</span><b>{{ account.name }}</b></div></td>
                <td class="pp-cell-wrap">{{ account.email }}
                    {% if account.hasSettingsOverrides %}
                        <a href="{{ path('antispam_account_edit', {id: account.id}) }}#mailboxSettings" class="label label-info" title="Własne ustawienia skrzynki: {{ account.settingsOverrides|keys|map(k => constant('AntispamBundle\\Services\\MailboxSettingsResolver::LABELS')[k] ?? k)|join(', ') }}">własne ustawienia</a>
                    {% endif %}
                </td>
                <td>
                    {% if account.connectionType == 'ssh' %}
                        <span class="label label-info">SSH+Maildir</span>
                    {% else %}
                        <span class="label label-default">IMAP</span>
                        {% if account.isOAuth() %}
                            {% set oauth_label = constant('AntispamBundle\\Services\\OAuth\\OAuthSettings::LABELS')[account.getOAuthProvider()] %}
                            {% if account.getOAuthError() %}
                                <a href="{{ path('antispam_account_edit', {id: account.id}) }}#oauth" class="label label-danger" title="{{ account.getOAuthError() }}">OAuth {{ oauth_label }}: błąd tokenu</a>
                            {% elseif account.isOAuthConnected() %}
                                <span class="label label-success" title="{{ account.isOAuthAppOnly() ? 'logowanie aplikacji (client credentials)' : 'połączono ' ~ (account.getOAuthConnectedAt() ? account.getOAuthConnectedAt()|date('Y-m-d H:i') : '') }}">OAuth {{ oauth_label }}</span>
                            {% else %}
                                <a href="{{ path('antispam_account_edit', {id: account.id}) }}#oauth" class="label label-warning">OAuth {{ oauth_label }}: niepołączone</a>
                            {% endif %}
                        {% endif %}
                    {% endif %}
                </td>
                <td class="pp-mono">
                    {% if account.connectionType == 'ssh' %}
                        {{ account.sshHost }}
                    {% else %}
                        {{ account.imapHost }}
                    {% endif %}
                </td>
                <td>
                    {% if account.connectionType == 'ssh' %}
                        {% if account.agentDeployed %}
                            <span class="label label-success">Wdrożony</span>
                        {% else %}
                            <span class="label label-warning">Niewdrożony</span>
                        {% endif %}
                    {% else %}
                        <span class="label label-default">n/d</span>
                    {% endif %}
                </td>
                <td class="pp-mono pp-cell-nowrap">
                    {% if account.lastScanAt %}
                        {{ account.lastScanAt|date('Y-m-d H:i') }}
                    {% else %}
                        <span class="text-muted">Nigdy</span>
                    {% endif %}
                    {# Background jobs of this account (docs/jobs.md) #}
                    {% for j in active_jobs[account.id]|default([]) %}
                        <br><a href="{{ path('antispam_job_show', {id: j.id}) }}" class="label label-{{ j.status == 'running' ? 'info' : 'default' }}" title="{{ j.label }}{{ j.progress ? ' - ' ~ j.progress : '' }}">{{ job_types[j.type]|default(j.type) }}: {{ j.status == 'running' ? 'trwa' : 'w kolejce' }}</a>
                    {% endfor %}
                </td>
                <td class="pp-row-actions">
                    {# Actions are POST + CSRF token; the buttons share one form. Below 1200 px only the icons show (pp-btn-text). #}
                    <form method="post" style="margin:0">
                    <input type="hidden" name="_token" value="{{ csrf_token('account_action_' ~ account.id) }}">
                    <div class="btn-group btn-group-xs">
                        <a href="{{ path('antispam_account_edit', {id: account.id}) }}" class="btn btn-default" title="Edytuj"><span class="glyphicon glyphicon-pencil" aria-hidden="true"></span> <span class="pp-btn-text">Edytuj</span></a>
                        <button type="submit" formaction="{{ path('antispam_account_test', {id: account.id}) }}" class="btn btn-info" title="Test połączenia"><span class="glyphicon glyphicon-link" aria-hidden="true"></span> <span class="pp-btn-text">Test</span></button>
                        <button type="submit" formaction="{{ path('antispam_account_scan', {id: account.id}) }}" class="btn btn-primary" title="Uruchom skan"><span class="glyphicon glyphicon-play" aria-hidden="true"></span> <span class="pp-btn-text">Skanuj</span></button>
                        <button type="submit" formaction="{{ path('antispam_account_rescan', {id: account.id}) }}" class="btn btn-default" title="Przeskanuj całą skrzynkę ponownie według aktualnych reguł (w tle, spam jest przenoszony, nie usuwany)" aria-label="Przeskanuj całą skrzynkę ponownie" data-confirm="Przeskanować całą skrzynkę odbiorczą {{ account.email }} ponownie według aktualnych reguł? Zadanie wykona się w tle; spam zostanie przeniesiony do SPAM / kwarantanny (nigdy usunięty)."><span class="glyphicon glyphicon-repeat" aria-hidden="true"></span></button>
                        {% if account.connectionType == 'ssh' %}
                            <button type="submit" formaction="{{ path('antispam_account_deploy', {id: account.id}) }}" class="btn btn-warning" title="Wdróż agenta"><span class="glyphicon glyphicon-cloud-upload" aria-hidden="true"></span> <span class="pp-btn-text">Wdróż</span></button>
                            <button type="submit" formaction="{{ path('antispam_account_sync', {id: account.id}) }}" class="btn btn-success" title="Synchronizuj reguły"><span class="glyphicon glyphicon-refresh" aria-hidden="true"></span> <span class="pp-btn-text">Synchronizuj</span></button>
                            <button type="submit" formaction="{{ path('antispam_account_health', {id: account.id}) }}" class="btn btn-info" title="Sprawdź stan agenta"><span class="glyphicon glyphicon-heart" aria-hidden="true"></span> <span class="pp-btn-text">Stan</span></button>
                        {% endif %}
                        <button type="submit" formaction="{{ path('antispam_account_del', {id: account.id}) }}" class="btn btn-danger" title="Usuń" aria-label="Usuń konto" data-confirm="Usunąć to konto?"><span class="glyphicon glyphicon-trash" aria-hidden="true"></span></button>
                    </div>
                    </form>
                </td>
            </tr>
            {% if account.lastScanResult or account.lastRescanAt or account.autoRescan %}
            <tr>
                <td colspan="7" class="pp-subrow">
                    {% set scanData = account.lastScanResultDecoded %}
                    {% if scanData %}
                        <div class="pp-scan-stats">
                            <span>Wszystkie <b>{{ scanData.total|default(0) }}</b></span>
                            <span>Sprawdzone <b>{{ scanData.checked|default(0) }}</b></span>
                            <span>Pominięte <b>{{ scanData.skipped|default(0) }}</b></span>
                            <span>Whitelista <b>{{ scanData.whitelisted|default(0) }}</b></span>
                            <span>Blacklista <b>{{ scanData.blacklisted|default(0) }}</b></span>
                            <span>Do spamu <b>{{ scanData.moved_to_spam|default(0) }}</b></span>
                        </div>
                    {% endif %}
                    {# Full rescan (docs/spam-handling.md#full-rescan) - never on the dashboard #}
                    {% set rescanData = account.lastRescanResultDecoded %}
                    {% if account.lastRescanAt or account.autoRescan %}
                        <div class="pp-scan-stats text-muted">
                            <span>Ponowny skan całej skrzynki:
                                {% if account.lastRescanAt %}<b>{{ account.lastRescanAt|date('Y-m-d H:i') }}</b>{% else %}jeszcze nie{% endif %}
                                {% if account.autoRescan %}<a href="{{ path('antispam_account_edit', {id: account.id}) }}#rescan" class="label label-default" title="Cotygodniowy ponowny skan">co tydzień: {{ constant('AntispamBundle\\Entity\\Account::WEEKDAYS')[account.effectiveRescanWeekday] }} {{ '%02d'|format(account.effectiveRescanHour) }}:00</a>{% endif %}
                            </span>
                            {% if rescanData and rescanData.error is defined %}
                                <span class="text-danger" title="{{ rescanData.error }}">błąd: {{ rescanData.error|length > 80 ? rescanData.error|slice(0, 80) ~ '…' : rescanData.error }}</span>
                            {% elseif rescanData %}
                                <span>Sprawdzone <b>{{ rescanData.checked|default(0) }}</b></span>
                                <span>Whitelista <b>{{ rescanData.whitelisted|default(0) }}</b></span>
                                <span>Do spamu <b>{{ rescanData.moved_to_spam|default(0) }}</b></span>
                                <span>Kwarantanna <b>{{ rescanData.quarantined|default(0) }}</b></span>
                            {% endif %}
                            {% if rescanData and rescanData.job is defined %}<a href="{{ path('antispam_job_show', {id: rescanData.job}) }}">zadanie #{{ rescanData.job }}</a>{% endif %}
                        </div>
                    {% endif %}
                </td>
            </tr>
            {% endif %}
        {% else %}
            <tr><td colspan="7" class="text-center text-muted" style="padding:40px;">Brak skonfigurowanych kont &mdash; <a href="{{ path('antispam_account_add') }}">dodaj pierwsze konto</a></td></tr>
        {% endfor %}
        </tbody>
    </table>
    </div>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('bundles/antispam/js/data-confirm.js') }}"></script>
{% endblock %}
