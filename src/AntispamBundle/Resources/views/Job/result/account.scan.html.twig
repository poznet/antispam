{# Result of a scan job (formerly Account/scan.html.twig). #}
{% if result.success|default(false) %}
    <div class="alert alert-success"><strong>Skanowanie zakończone!</strong>
        {% if result.scan_result.initial|default(false) %}<br><small>Pierwsze skanowanie skrzynki - wiadomości z tego przebiegu nie są wliczane do statystyk.</small>{% endif %}
    </div>

    {% if result.scan_result is defined %}
    <div class="table-responsive">
    <table class="table table-bordered">
        <tr><th>Wszystkie wiadomości</th><td>{{ result.scan_result.total|default(0) }}</td></tr>
        <tr><th>Sprawdzone</th><td>{{ result.scan_result.checked|default(0) }}</td></tr>
        <tr><th>Pominięte (już sprawdzone)</th><td>{{ result.scan_result.skipped|default(0) }}</td></tr>
        <tr><th>Z whitelisty</th><td>{{ result.scan_result.whitelisted|default(0) }}</td></tr>
        <tr><th>Z blacklisty</th><td>{{ result.scan_result.blacklisted|default(0) }}</td></tr>
        <tr><th>Przeniesione do spamu</th><td>{{ result.scan_result.moved_to_spam|default(0) }}</td></tr>
        <tr><th>Przeniesione do kwarantanny</th><td>{{ result.scan_result.quarantined|default(0) }}</td></tr>
    </table>
    </div>
    {% if result.scan_result.errors|default([])|length > 0 %}
    <div class="alert alert-warning">
        <strong>Nie udało się przetworzyć części wiadomości:</strong>
        <ul>{% for e in result.scan_result.errors %}<li><small>{{ e }}</small></li>{% endfor %}</ul>
    </div>
    {% endif %}
    {% endif %}
{% else %}
    <div class="alert alert-danger"><strong>Skanowanie nie powiodło się</strong></div>
    <ul class="list-group">
    {% for message in result.messages|default([]) %}
        <li class="list-group-item">{{ message }}</li>
    {% endfor %}
    </ul>
{% endif %}
